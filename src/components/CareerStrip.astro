---
// Every phrase restates content/resume.md (Experience and Education). Dates are the resume's.
import { url } from '../lib/url';
const rows = [
	{
		when: '2020–21',
		org: 'Amazon',
		role: 'Software Development Engineer',
		what: 'Java backend microservices for Amazon Retail Mobile (over 10 million daily active users); migrated legacy services to AWS-native infrastructure with zero downtime.',
	},
	{
		when: '2021–22',
		org: 'Bizanalytica',
		role: 'Software Engineer',
		what: 'data-lake infrastructure on Snowflake; automated Python ingestion for JSON and XML feeds.',
	},
	{
		when: '2022–now',
		org: 'Ingram Micro',
		role: 'Replication Engineer → Data Platform Engineer → Senior Data Platform Engineer',
		what: 'the platform below.',
	},
];
---

<section class="career" aria-labelledby="career-heading">
	<h2 id="career-heading" class="eyebrow">Before this · how I got here</h2>
	<ol>
		{
			rows.map((r) => (
				<li>
					<span class="when">{r.when}</span>
					<span class="sr-only"> · </span>
					<strong class="org">{r.org}</strong>
					<span class="sr-only"> · </span>
					<span class="role">{r.role}</span>
					<span class="sr-only"> — </span>
					<span class="what">{r.what}</span>
				</li>
			))
		}
	</ol>
	<p class="foot">
		M.S. Computer Science and Engineering, University at Buffalo
		<a href={url('projects/simple-dynamo/')}>Simple Dynamo ring →</a>
		<a href={url('resume/')}>Full history on the resume →</a>
	</p>
</section>

<style>
	.career {
		margin-bottom: 2rem;
	}
	h2 {
		margin: 0 0 1.25rem;
	}
	/* a timeline row: one rail, a dot per role, newest on the right */
	ol {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ol::before {
		content: '';
		position: absolute;
		top: 0.3125rem;
		inset-inline: 0;
		height: 2px;
		border-radius: 1px;
		background: var(--rule);
	}
	li {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding-top: 1.5rem;
		font-size: 0.9375rem;
		line-height: 1.5;
	}
	li::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 0.75rem;
		height: 0.75rem;
		border: 2px solid var(--bg);
		border-radius: 50%;
		background: var(--muted);
	}
	li:last-child::before {
		background: var(--accent);
	}
	.when {
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		font-variant-numeric: tabular-nums;
	}
	.org {
		font-size: 1.1875rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.role {
		color: var(--muted);
	}
	.what::first-letter {
		text-transform: uppercase;
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin: 1.75rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
	}
	@media (max-width: 48rem) {
		ol {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding-left: 1.5rem;
		}
		ol::before {
			top: 0.375rem;
			bottom: 0.375rem;
			left: 0.3125rem;
			width: 2px;
			height: auto;
		}
		li {
			padding-top: 0;
		}
		li::before {
			top: 0.125rem;
			left: -1.5rem;
		}
	}
</style>
