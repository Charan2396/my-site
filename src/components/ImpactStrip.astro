---
// Figures quoted from the first Experience bullet in content/resume.md. Static on purpose: no count-up.
// The stack row lists only tools named in content/resume.md, ordered for data-engineering readers.
const tiles = [
	{ prefix: '', count: 300, suffix: '+', unit: 'tables', caption: 'IMS, Db2 and VSAM, replicated into Oracle' },
	{ prefix: '', count: 30, suffix: '+', unit: 'downstream teams', caption: 'served by the platform' },
	{ prefix: '~', count: 10, suffix: 'M', unit: 'rows/day', caption: 'through the pipeline' },
	{ prefix: '', count: 3, suffix: '', unit: 'Oracle instances', caption: 'production operational data stores' },
];
const stack = [
	'Change data capture (CDC)',
	'Event-driven messaging',
	'IBM MQ',
	'Google Cloud Pub/Sub',
	'BigQuery',
	'Oracle 19c',
	'PL/SQL',
	'Snowflake',
	'Python',
	'Java',
	'SQL',
	'Datadog',
	'AWS',
	'Airflow (in progress)',
];
---

<section class="impact" aria-labelledby="impact-heading">
	<h2 id="impact-heading" class="eyebrow">At a glance · the platform I run today</h2>
	<ul class="card card-lg">
		{
			tiles.map((t) => (
				<li>
					<span class="sr-only">{`${t.prefix}${t.count}${t.suffix} ${t.unit}: ${t.caption}`}</span>
					<span class="figure" aria-hidden="true">
						<span class="value">{`${t.prefix}${t.count}${t.suffix}`}</span>
						<span class="unit">{t.unit}</span>
					</span>
					<span class="caption" aria-hidden="true">
						{t.caption}
					</span>
				</li>
			))
		}
	</ul>
	<p class="stack"><span class="stack-label">Stack</span> {stack.join(' · ')}</p>
</section>

<style>
	.impact {
		margin-bottom: 4rem;
	}
	h2 {
		margin: 0 0 1rem;
	}
	ul {
		display: grid;
		/* 4 across when wide, 2 × 2 below that: never a 3 + 1 orphan */
		grid-template-columns: repeat(4, 1fr);
		margin: 0;
		padding: 0.5rem 0;
		list-style: none;
	}
	li {
		display: grid;
		align-content: start;
		gap: 0.375rem;
		padding: 1.5rem 1.75rem;
	}
	/* hairline between columns, not boxes */
	li + li {
		border-left: 1px solid var(--rule);
	}
	.figure {
		display: grid;
		gap: 0.125rem;
	}
	.value {
		color: var(--ink);
		font-size: clamp(2.5rem, 4.5vw, 3.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.035em;
		font-variant-numeric: tabular-nums;
	}
	.unit {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.005em;
	}
	.caption {
		font-size: 0.875rem;
	}
	.stack {
		max-width: 60rem;
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}
	.stack-label {
		margin-right: 0.5rem;
		color: var(--ink);
		font-weight: 600;
	}
	@media (max-width: 64rem) {
		ul {
			grid-template-columns: 1fr 1fr;
			padding: 0;
		}
		li:nth-child(odd) {
			border-left: 0;
		}
		li:nth-child(n + 3) {
			border-top: 1px solid var(--rule);
		}
	}
	@media (max-width: 40rem) {
		li {
			padding: 1.25rem 1rem;
		}
		.value {
			font-size: 2.25rem;
		}
	}
</style>
