---
// Figures quoted from the first Experience bullet in content/resume.md. Static on purpose: no count-up.
// The stack row lists only tools named in content/resume.md, ordered for data-engineering readers.
const tiles = [
	{ prefix: '', count: 300, suffix: '+', unit: 'tables', caption: 'IMS, Db2 and VSAM, replicated into Oracle' },
	{ prefix: '', count: 30, suffix: '+', unit: 'downstream teams', caption: 'served by the platform' },
	{ prefix: '~', count: 10, suffix: 'M', unit: 'rows/day', caption: 'through the pipeline' },
	{ prefix: '', count: 3, suffix: '', unit: 'Oracle instances', caption: 'production operational data stores' },
];
const stack = [
	'Change data capture (CDC)',
	'Event-driven messaging',
	'IBM MQ',
	'Google Cloud Pub/Sub',
	'BigQuery',
	'Oracle 19c',
	'PL/SQL',
	'Snowflake',
	'Python',
	'Java',
	'SQL',
	'Datadog',
	'AWS',
	'Airflow (in progress)',
];
---

<section class="impact" aria-labelledby="impact-heading">
	<h2 id="impact-heading" class="mono">At a glance · the platform I run today</h2>
	<ul>
		{
			tiles.map((t) => (
				<li>
					<span class="sr-only">{`${t.prefix}${t.count}${t.suffix} ${t.unit}: ${t.caption}`}</span>
					<span class="figure" aria-hidden="true">
						<span class="value mono">{`${t.prefix}${t.count}${t.suffix}`}</span>
						<span class="unit">{t.unit}</span>
					</span>
					<span class="caption mono" aria-hidden="true">
						{t.caption}
					</span>
				</li>
			))
		}
	</ul>
	<p class="stack mono"><span class="stack-label">Stack</span> {stack.join(' · ')}</p>
</section>

<style>
	.impact {
		margin-bottom: 2rem;
	}
	h2 {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	ul {
		display: grid;
		/* 4 across when wide, 2 × 2 below that: never a 3 + 1 orphan */
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: grid;
		gap: 0.25rem;
		padding: 0.875rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.figure {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.5rem;
	}
	.value {
		color: var(--line);
		font-size: 2rem;
		font-weight: 600;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}
	.unit {
		font-weight: 600;
	}
	.caption {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
	}
	.stack {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.7;
	}
	.stack-label {
		margin-right: 0.5rem;
		color: var(--line);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	@media (max-width: 64rem) {
		ul {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 40rem) {
		.value {
			font-size: 1.625rem;
		}
	}
</style>
