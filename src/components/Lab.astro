---
// "Break my pipeline": pick a failure, throw it at the five stages, switch its defense off and watch it land.
// A simulation on invented sample data. Without JS: a static table of every round (the same text the script uses).
import { stages } from '../lib/stages';
import { rounds } from '../lib/lab';
---

<section class="lab" data-lab aria-labelledby="lab-title">
	<h2 id="lab-title" class="sr-only">The fight card</h2>

	<div class="rounds" data-controls role="group" aria-label="Round" hidden>
		{
			rounds.map((r) => (
				<button type="button" class="round" data-round={r.id} aria-pressed="false">
					<span class="rn" aria-hidden="true">R{r.n}</span>
					{r.failure}
				</button>
			))
		}
	</div>

	<div class="stage-wrap" data-lane hidden aria-hidden="true">
		<ol class="lane">
			{
				stages.map((s) => (
					<li data-node={s.key}>
						<span class="lamp" />
						<b>{s.label}</b>
						<span class="sys">{s.system}</span>
						<span class="tag" data-tag />
					</li>
				))
			}
		</ol>
		<span class="token" data-token><span></span></span>
	</div>

	<div class="score" data-score hidden>
		<p class="verdict" data-verdict></p>
		<button type="button" class="btn guard" data-guard aria-pressed="true">
			<span class="switch" aria-hidden="true"></span>
			<span>Defense <b data-guard-state>on</b>: <span data-defense></span></span>
		</button>
		<p class="say" data-live aria-live="polite"></p>
		<p class="talk" data-talk></p>
	</div>

	<table data-fallback>
		<caption class="caption">The five rounds, with and without the defense (simulation, invented sample data)</caption>
		<thead>
			<tr><th scope="col">Round</th><th scope="col">Defense on</th><th scope="col">Defense off</th></tr>
		</thead>
		<tbody>
			{
				rounds.map((r) => (
					<tr>
						<th scope="row">
							{r.n}. {r.failure}
							<span class="caption"> · {r.defense}</span>
						</th>
						<td>{r.on}</td>
						<td class="bad">{r.off}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</section>

<script>
	import { createSpring } from '../lib/spring';
	import { onPage } from '../lib/stepper';
	import { allOn, rounds, simulate } from '../lib/lab';

	onPage((signal) => {
		for (const root of document.querySelectorAll<HTMLElement>('[data-lab]:not([data-ready])')) {
			root.dataset.ready = '';
			signal.addEventListener('abort', () => delete root.dataset.ready);
			const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
			const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-round]')];
			const nodes = [...root.querySelectorAll<HTMLElement>('[data-node]')];
			const token = $('[data-token]');
			const verdict = $('[data-verdict]'), live = $('[data-live]'), talk = $('[data-talk]');
			const guardBtn = $<HTMLButtonElement>('[data-guard]');
			const reduced = matchMedia('(prefers-reduced-motion: reduce)');
			const guards = allOn();
			let current = rounds[0];
			let run = 0;
			let afterRest: (() => void) | undefined;
			// the token's position in stage units; it rides the same critically damped spring as the rest of the site
			const spring = createSpring((v) => (token.style.transform = `translateX(${v * 100}%)`), 0, 0.002, () => {
				const f = afterRest;
				afterRest = undefined;
				f?.();
			});
			signal.addEventListener('abort', () => spring.stop());

			const mark = (i: number, cls: string, tag: string) => {
				nodes[i].classList.add(cls);
				nodes[i].querySelector<HTMLElement>('[data-tag]')!.textContent = tag;
			};
			const clear = () =>
				nodes.forEach((n) => {
					n.classList.remove('is-hit', 'is-caught', 'is-missed');
					n.querySelector<HTMLElement>('[data-tag]')!.textContent = '';
				});

			const play = (announce: boolean) => {
				const id = ++run;
				afterRest = undefined;
				const res = simulate(current.id, guards);
				const word = res.outcome === 'caught' ? 'Caught' : 'Missed';
				for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.round === current.id));
				guardBtn.setAttribute('aria-pressed', String(guards[current.guard]));
				$('[data-guard-state]').textContent = guards[current.guard] ? 'on' : 'off';
				$('[data-defense]').textContent = current.defense;
				talk.textContent = '';
				clear();
				verdict.textContent = `Round ${current.n} · ${current.failure}`;
				live.textContent = '';
				const finish = () => {
					if (id !== run) return;
					clear();
					mark(res.hit, 'is-hit', 'hit');
					mark(res.end, res.outcome === 'caught' ? 'is-caught' : 'is-missed', word.toLowerCase());
					verdict.textContent = `Round ${current.n} · ${current.failure} · ${word.toUpperCase()}`;
					live.textContent = `${current.hitSay} ${res.say}`;
					talk.textContent = current.talk;
				};
				if (reduced.matches || !announce) {
					spring.set(res.end);
					finish();
					return;
				}
				// move to where it strikes, then to where the defense acts
				spring.set(0);
				afterRest = () => {
					if (id !== run) return;
					mark(res.hit, 'is-hit', 'hit');
					if (res.end === res.hit) return finish();
					afterRest = finish;
					spring.to(res.end, { response: 0.6 });
				};
				spring.to(res.hit, { response: 0.6 });
			};

			for (const b of buttons)
				b.addEventListener('click', () => ((current = rounds.find((r) => r.id === b.dataset.round)!), play(true)), { signal });
			guardBtn.addEventListener('click', () => ((guards[current.guard] = !guards[current.guard]), play(true)), { signal });
			// arrow keys move between rounds
			$('[data-controls]').addEventListener(
				'keydown',
				(e) => {
					if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
					e.preventDefault();
					const i = rounds.indexOf(current) + (e.key === 'ArrowRight' ? 1 : -1);
					if (i < 0 || i >= rounds.length) return;
					current = rounds[i];
					buttons[i].focus();
					play(true);
				},
				{ signal },
			);

			$('[data-controls]').hidden = $('[data-lane]').hidden = $('[data-score]').hidden = false;
			$('[data-fallback]').hidden = true;
			play(false);
		}
	});
</script>

<style>
	.lab {
		display: grid;
		gap: var(--space-6);
	}
	[hidden] {
		display: none !important;
	}
	.rounds {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.round {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.75rem;
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		font: 600 var(--text-sm) / 1.2 var(--font-sans);
		cursor: pointer;
	}
	.round[aria-pressed='true'] {
		border-color: var(--accent);
		color: var(--accent);
	}
	.rn {
		color: var(--heat);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}
	.stage-wrap {
		position: relative;
		padding-top: var(--space-2);
	}
	.lane {
		position: relative;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* the rail the record rides along, behind the lamps */
	.lane::before {
		content: '';
		position: absolute;
		top: calc(var(--space-2) + 0.4375rem);
		inset-inline: 10%;
		height: 2px;
		background: var(--rule);
	}
	.lane li {
		position: relative;
		display: grid;
		justify-items: center;
		gap: var(--space-1);
		text-align: center;
		font-size: var(--text-xs);
	}
	.lamp {
		width: 0.875rem;
		height: 0.875rem;
		margin-top: var(--space-2);
		border: 2px solid var(--muted);
		border-radius: 50%;
		background: var(--bg);
	}
	.lane b {
		font-size: var(--text-xs);
	}
	.sys {
		color: var(--muted);
	}
	.tag {
		min-height: 1.2em;
		font-family: var(--font-mono);
		font-weight: 600;
		text-transform: uppercase;
	}
	.is-hit .lamp {
		border-color: var(--heat);
		background: var(--heat);
	}
	.is-hit .tag {
		color: var(--heat);
	}
	.is-caught .lamp {
		border-color: var(--accent);
		background: var(--accent);
	}
	.is-caught .tag {
		color: var(--accent);
	}
	.is-missed .lamp {
		border-color: var(--error);
		background: var(--error);
	}
	.is-missed .tag {
		color: var(--error);
	}
	/* the record: one column wide, moved in stage units by the spring */
	.token {
		position: absolute;
		top: var(--space-2);
		left: 0;
		width: 20%;
		display: grid;
		place-items: center;
		pointer-events: none;
		will-change: transform;
	}
	.token span {
		width: 1.5rem;
		height: 1.5rem;
		margin-top: calc(var(--space-2) - 0.3125rem);
		border-radius: 50%;
		background: color-mix(in srgb, var(--heat) 45%, transparent);
		box-shadow: 0 0 0 2px var(--heat);
	}
	.score {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-5) var(--space-6);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-xl);
		background: var(--surface);
		box-shadow: var(--shadow-md);
	}
	.verdict {
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.03em;
	}
	.guard {
		justify-self: start;
		color: var(--ink);
	}
	.switch {
		position: relative;
		flex: none;
		width: 2rem;
		height: 1.125rem;
		border-radius: 999px;
		background: var(--fill-strong);
		transition: background-color 0.2s ease;
	}
	.switch::after {
		content: '';
		position: absolute;
		top: 0.125rem;
		left: 0.125rem;
		width: 0.875rem;
		height: 0.875rem;
		border-radius: 50%;
		background: var(--ink);
		transition: transform 0.2s ease;
	}
	.guard[aria-pressed='true'] .switch {
		background: var(--accent);
	}
	.guard[aria-pressed='true'] .switch::after {
		transform: translateX(0.875rem);
		background: var(--on-accent);
	}
	.say {
		margin: 0;
		max-width: var(--measure);
	}
	.talk {
		margin: 0;
		max-width: var(--measure);
		color: var(--muted);
		font-size: var(--text-sm);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-sm);
	}
	th,
	td {
		padding: var(--space-3);
		border-bottom: 1px solid var(--rule);
		text-align: left;
		vertical-align: top;
	}
	.bad {
		color: var(--error);
	}
	@media (max-width: 40rem) {
		.sys {
			display: none;
		}
		.score {
			padding: var(--space-4);
		}
	}
</style>
