---
import { stages, corruptSource } from '../lib/stages';
import { incidentSteps } from '../lib/incident';
import { url } from '../lib/url';

interface Props {
	/** First published story per stage; stages without one render as plain text, never a dead link. */
	storyByStage: Partial<Record<string, string>>;
}
const { storyByStage } = Astro.props;
const storyHref = (key: string) => (storyByStage[key] ? url(`stories/${storyByStage[key]}/`) : undefined);
// Samples mark the changed field with [[ ]]; odd split parts are the marked ones.
const parts = (text: string) => text.split(/\[\[|\]\]/);
const corruptLines = corruptSource.split('\n');
const sourceStory = storyHref('source');
---

<div class="record-view" data-record-view>
	<figure class="pipeline">
		<figcaption class="mono">fig. 1 · one record's path through the platform</figcaption>
		<ol>
			{
				stages.map((s, i) => {
					const href = storyHref(s.key);
					return (
						<li>
							<button class="pick" type="button" data-pick={i} aria-pressed={i === 0 ? 'true' : 'false'} hidden>
								<span class="sr-only">
									Show the record at stage {i + 1}, {s.label}
								</span>
							</button>
							<div class="stage" data-stage>
								<span class="num mono" aria-hidden="true">{i + 1}</span>
								<span class="label mono">{s.label}</span>
								<span class="system">{s.system}</span>
								<span class="detail">{s.detail}</span>
								{s.key === 'process' && (
									<span class="flag mono" aria-hidden="true">
										✕ rejecting
									</span>
								)}
								{href && (
									<a class="cta mono" href={href}>
										Read the story<span class="sr-only">: {s.label} stage</span> →
									</a>
								)}
							</div>
						</li>
					);
				})
			}
		</ol>
		<span class="token mono" aria-hidden="true" data-token hidden><i></i>4471/2</span>
	</figure>

	<figure class="records">
		<figcaption class="mono">
			fig. 2 · the same order line at each stage · <mark>highlight</mark> = the changed field (qty 2 → 3)
		</figcaption>
		<div class="controls" data-controls hidden>
			<button type="button" data-step="-1">← Prev</button>
			<span class="mono" data-count aria-hidden="true">1 / {stages.length}</span>
			<button type="button" data-step="1">Next →</button>
		</div>
		<p class="sr-only" aria-live="polite" data-live></p>
		<ol class="versions">
			{
				stages.map((s, i) => {
					const href = storyHref(s.key);
					return (
						<li data-version>
							<header>
								<span class="num mono" aria-hidden="true">{i + 1}</span>
								<h3>
									{s.label} <span>· {s.system}</span>
								</h3>
								<span class="format mono">{s.format}</span>
							</header>
							<pre tabindex="0" aria-label={`Sample record at the ${s.label} stage`}>{parts(s.sample).map((p, j) => (j % 2 ? <mark>{p}</mark> : p))}</pre>
							{href && (
								<p class="story mono">
									<a href={href}>
										Read the story<span class="sr-only">: {s.label} stage</span> →
									</a>
								</p>
							)}
						</li>
					);
				})
			}
		</ol>
	</figure>

	<figure class="incident" data-incident>
		<figcaption class="mono">fig. 3 · incident replay: one bad message</figcaption>
		<button class="start" type="button" data-replay hidden>Replay the incident: inject the corrupt message</button>
		<div class="controls" data-icontrols hidden>
			<button type="button" data-istep="-1">← Prev</button>
			<span class="mono" data-icount aria-hidden="true">1 / {incidentSteps.length}</span>
			<button type="button" data-istep="1">Next →</button>
			<button type="button" data-play hidden>Play</button>
			<button type="button" data-exit>Exit replay</button>
		</div>
		<ol class="steps" data-steps>
			{
				incidentSteps.map((st, i) => (
					<li data-step-item data-at={st.at} data-lit={(st.lit ?? [st.at]).join(' ')} data-error={st.error ? '' : undefined}>
						<header>
							<span class="num mono" aria-hidden="true">{i + 1}</span>
							<h3>{st.title}</h3>
						</header>
						<p>{st.caption}</p>
						{st.show === 'corrupt' && (
							<pre tabindex="0" aria-label="The corrupt Source record, with its uneven line breaks marked">{corruptLines.map((l, j) => (j < corruptLines.length - 1 ? [l, <mark>⏎</mark>, '\n'] : l))}</pre>
						)}
						{st.backlog && (
							<div class={`backlog is-${st.backlog}`}>
								<span class="bar" aria-hidden="true"><span /></span>
								<span class="mono">
									{st.backlog === 'drain' ? 'backlog drained: clean copies landed in Oracle' : 'tens of thousands of messages rejected'}
								</span>
							</div>
						)}
						{st.show === 'alert' && <pre class="alert">ALERT  missing rows: order_line not landing in Oracle</pre>}
						{st.show === 'keys' && (
							<pre>{`affected keys (order_id/line_no)
4471/2
4471/3
5502/1
…
→ fed back to the mainframe for regeneration`}</pre>
						)}
						{st.show === 'story' && sourceStory && (
							<p class="mono">
								<a href={sourceStory}>Read the full story →</a>
							</p>
						)}
					</li>
				))
			}
		</ol>
	</figure>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-record-view]')) {
		const versions = [...root.querySelectorAll<HTMLElement>('[data-version]')];
		const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
		const boxes = [...root.querySelectorAll<HTMLElement>('[data-stage]')];
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const panel = root.querySelector<HTMLElement>('.records')!;
		const token = root.querySelector<HTMLElement>('[data-token]')!;
		const steps = [...root.querySelectorAll<HTMLElement>('[data-step-item]')];
		const stepList = root.querySelector<HTMLElement>('[data-steps]')!;
		const startBtn = root.querySelector<HTMLButtonElement>('[data-replay]')!;
		const iControls = root.querySelector<HTMLElement>('[data-icontrols]')!;
		const iCount = root.querySelector<HTMLElement>('[data-icount]')!;
		const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)');
		let current = 0;
		let step = -1; // -1 = not replaying
		let at = 0;
		let timer = 0;

		// move the record token onto stage box `i` (top-right corner, riding the box border)
		const place = () => {
			const li = boxes[at].parentElement!;
			const x = li.offsetLeft + li.offsetWidth - token.offsetWidth - 12;
			const y = li.offsetTop - token.offsetHeight / 2;
			token.style.transform = `translate(${x}px, ${y}px)`;
		};
		const paint = (i: number, lit = [i], error = false) => {
			at = i;
			boxes.forEach((b, j) => {
				b.classList.toggle('is-on', lit.includes(j));
				b.classList.toggle('is-error', error && j === 2);
			});
			place();
		};

		const show = (i: number, announce = true) => {
			current = (i + versions.length) % versions.length;
			versions.forEach((v, j) => (v.hidden = j !== current));
			picks.forEach((b, j) => b.setAttribute('aria-pressed', String(j === current)));
			count.textContent = `${current + 1} / ${versions.length}`;
			if (step < 0) paint(current);
			if (announce) live.textContent = `Stage ${current + 1} of ${versions.length}: ${versions[current].querySelector('h3')!.textContent}`;
		};

		const stopPlay = () => {
			clearInterval(timer);
			timer = 0;
			playBtn.textContent = 'Play';
		};
		const go = (n: number) => {
			step = Math.max(0, Math.min(steps.length - 1, n));
			steps.forEach((s, j) => (s.hidden = j !== step));
			const s = steps[step].dataset;
			paint(Number(s.at), s.lit ? s.lit.split(' ').map(Number) : [], 'error' in s);
			iCount.textContent = `${step + 1} / ${steps.length}`;
			live.textContent = `Incident step ${step + 1} of ${steps.length}: ${steps[step].querySelector('h3')!.textContent}`;
			if (step === steps.length - 1) stopPlay();
		};
		const exitReplay = (focus = true) => {
			if (step < 0) return;
			stopPlay();
			step = -1;
			root.classList.remove('in-replay');
			stepList.hidden = iControls.hidden = true;
			startBtn.hidden = false;
			paint(current);
			live.textContent = `Replay closed. Stage ${current + 1} of ${versions.length}.`;
			if (focus) startBtn.focus();
		};

		root.classList.add('is-stepper');
		for (const el of [...picks, root.querySelector<HTMLElement>('[data-controls]')!, startBtn, token]) el.hidden = false;
		stepList.hidden = true;
		const syncPlay = () => (playBtn.hidden = reduced.matches);
		syncPlay();
		reduced.addEventListener('change', () => (stopPlay(), syncPlay()));

		picks.forEach((b, j) =>
			b.addEventListener('click', () => {
				exitReplay(false);
				show(j);
				// on narrow screens the panel sits below the stacked stages
				panel.scrollIntoView({ block: 'nearest', behavior: reduced.matches ? 'auto' : 'smooth' });
			}),
		);
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-step]'))
			b.addEventListener('click', () => (exitReplay(false), show(current + Number(b.dataset.step))));
		for (const b of root.querySelectorAll<HTMLButtonElement>('[data-istep]'))
			b.addEventListener('click', () => (stopPlay(), go(step + Number(b.dataset.istep))));
		startBtn.addEventListener('click', () => {
			root.classList.add('in-replay');
			startBtn.hidden = true;
			stepList.hidden = iControls.hidden = false;
			go(0);
			iControls.querySelector<HTMLButtonElement>('[data-istep="1"]')!.focus();
		});
		root.querySelector('[data-exit]')!.addEventListener('click', () => exitReplay());
		playBtn.addEventListener('click', () => {
			if (timer) return stopPlay();
			if (reduced.matches) return;
			if (step === steps.length - 1) go(0);
			playBtn.textContent = 'Pause';
			timer = window.setInterval(() => go(step + 1), 2000);
		});
		root.addEventListener('keydown', (e) => {
			// leave arrows alone inside scrollable record boxes
			if (e.altKey || e.ctrlKey || e.metaKey || (e.target as HTMLElement).closest('pre')) return;
			if (e.key === 'Escape' && step >= 0) return exitReplay();
			if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
			e.preventDefault();
			const d = e.key === 'ArrowRight' ? 1 : -1;
			if (step >= 0) return stopPlay(), go(step + d);
			show(current + d);
			if (picks.includes(document.activeElement as HTMLButtonElement)) picks[current].focus();
		});
		addEventListener('resize', place);
		document.fonts?.ready.then(place);
		show(0, false);
		// first placement without a slide; later moves animate (CSS transition, zeroed under reduced motion)
		requestAnimationFrame(() => token.classList.add('can-move'));
	}
</script>

<style>
	.record-view {
		display: grid;
		gap: 2.5rem;
	}
	figure {
		margin: 0;
		min-width: 0;
	}
	figcaption {
		margin-bottom: 1rem;
		color: var(--muted);
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	mark {
		padding: 0 0.15em;
		background: color-mix(in srgb, var(--line) 16%, transparent);
		color: inherit;
		box-shadow: inset 0 -2px 0 var(--line);
	}

	/* fig. 1: the stage boxes */
	.pipeline ol {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.pipeline li {
		position: relative;
		display: flex;
	}
	/* connector: horizontal arrow to the next stage */
	.pipeline li:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 2.25rem;
		left: 100%;
		width: 2rem;
		height: 1px;
		background: var(--line);
	}
	.pipeline li:not(:last-child)::before {
		content: '';
		position: absolute;
		top: calc(2.25rem - 4px);
		left: calc(100% + 2rem - 8px);
		border: 4.5px solid transparent;
		border-left: 7px solid var(--line);
		z-index: 1;
	}
	.stage {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		width: 100%;
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--ink);
		transition:
			box-shadow 0.15s,
			background-color 0.15s;
	}
		/* with JS, a transparent button covers each box; the story link stays clickable above it */
	.pick {
		position: absolute;
		inset: 0;
		z-index: 2;
		padding: 0;
		border: 0;
		border-radius: var(--radius);
		background: none;
		cursor: pointer;
	}
	.pick[hidden] {
		display: none;
	}
	.pick:hover + .stage {
		box-shadow: inset 0 0 0 1px var(--line);
	}
	.stage.is-on {
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--line) 9%, var(--surface));
		box-shadow:
			inset 0 0 0 1px var(--line),
			0 4px 0 -2px var(--line);
	}
	.num {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--line);
		font-size: 0.8125rem;
	}
	.stage.is-on .num {
		background: var(--line);
		color: var(--surface);
	}
	.label {
		margin-top: 0.5rem;
		color: var(--line);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.system {
		font-weight: 600;
		font-size: 1.0625rem;
	}
	.detail {
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.4;
	}
	.cta {
		position: relative;
		z-index: 3;
		align-self: flex-start;
		margin-top: auto;
		padding-top: 0.75rem;
		font-size: 0.75rem;
		color: var(--line);
	}
	a.cta {
		text-decoration: none;
	}
	a.cta:hover {
		text-decoration: underline;
	}
	/* Process box while the splitter is rejecting (replay steps 3-5); text, not only colour */
	.flag {
		display: none;
		align-self: flex-start;
		margin-top: 0.5rem;
		padding: 0 0.375rem;
		border: 1px solid var(--error);
		border-radius: var(--radius);
		color: var(--error);
		font-size: 0.75rem;
	}
	.stage.is-error {
		border-color: var(--error);
		background: var(--error-bg);
		box-shadow:
			inset 0 0 0 1px var(--error),
			0 4px 0 -2px var(--error);
	}
	.stage.is-error .flag {
		display: block;
	}
	.stage.is-error .num {
		border-color: var(--error);
		background: var(--error);
		color: var(--surface);
	}

	/* the record token: rides the top border of the current stage box */
	.pipeline {
		position: relative;
	}
	.pipeline ol {
		padding-top: 0.75rem;
	}
	.token {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 4;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.125rem 0.375rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--line);
		font-size: 0.6875rem;
		line-height: 1.4;
		pointer-events: none;
	}
	.token[hidden] {
		display: none;
	}
	.token i {
		width: 0.5rem;
		height: 0.5rem;
		background: var(--line);
	}
	.token.can-move {
		transition: transform 0.6s ease-in-out;
	}
	.in-replay .token {
		border-color: var(--error);
		color: var(--error);
	}
	.in-replay .token i {
		background: var(--error);
	}

	/* fig. 2: the record at each stage */
	.records {
		position: relative;
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}
	.controls[hidden],
	.start[hidden] {
		display: none;
	}
	.controls {
		flex-wrap: wrap;
	}
	.controls button,
	.start {
		padding: 0.375rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--line);
		font: 0.8125rem var(--font-mono);
		cursor: pointer;
	}
	.controls button:hover,
	.start:hover {
		background: color-mix(in srgb, var(--line) 9%, var(--surface));
	}
	.controls span {
		color: var(--muted);
		font-size: 0.8125rem;
	}
	.versions {
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.versions li {
		min-width: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.is-stepper .versions li:not([hidden]) {
		animation: arrive 0.2s ease-out;
	}
	@keyframes arrive {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}
	.versions header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
		padding: 0.75rem 1rem;
		border-bottom: 1px dashed var(--rule);
	}
	.versions h3 {
		margin: 0;
		font-size: 1rem;
	}
	.versions h3 span {
		color: var(--muted);
		font-weight: 400;
	}
	.format {
		margin-left: auto;
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		color: var(--muted);
		font-size: 0.75rem;
	}
	pre {
		margin: 0;
		padding: 1rem;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.55;
	}
	/* fig. 3: incident replay; without JS all steps show as a timeline */
	.start {
		padding: 0.5rem 0.875rem;
		border-color: var(--error);
		color: var(--error);
	}
	.steps {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.steps[hidden],
	.steps li[hidden] {
		display: none;
	}
	.steps li {
		min-width: 0;
		padding: 0.75rem 1rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.is-stepper .steps li:not([hidden]) {
		animation: arrive 0.2s ease-out;
	}
	.steps header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.steps h3 {
		margin: 0;
		font-size: 1rem;
	}
	.steps p {
		margin: 0.5rem 0 0;
		max-width: var(--measure);
	}
	.steps pre {
		margin-top: 0.75rem;
		border: 1px dashed var(--rule);
		border-left: 3px solid var(--line);
	}
	.steps pre.alert {
		border-left-color: var(--error);
		background: var(--error-bg);
		color: var(--error);
		white-space: pre-wrap;
	}
	.backlog {
		display: grid;
		gap: 0.25rem;
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.backlog .bar {
		display: block;
		max-width: 24rem;
		height: 0.75rem;
		border: 1px solid var(--error);
	}
	.backlog .bar span {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--error);
	}
	.backlog.is-drain .bar {
		border-style: dashed;
		border-color: var(--rule);
	}
	.backlog.is-drain .bar span {
		width: 0;
	}
	.is-stepper .backlog.is-grow .bar span {
		animation: grow 1.6s ease-out;
	}
	.is-stepper .backlog.is-drain .bar span {
		animation: drain 1.6s ease-in;
	}
	@keyframes grow {
		from {
			width: 6%;
		}
		to {
			width: 100%;
		}
	}
	@keyframes drain {
		from {
			width: 100%;
		}
		to {
			width: 0;
		}
	}
	.story {
		margin: 0;
		padding: 0.625rem 1rem;
		border-top: 1px dashed var(--rule);
		color: var(--muted);
		font-size: 0.8125rem;
	}

	/* narrow screens: stack vertically, connectors point down */
	@media (max-width: 56rem) {
		.pipeline ol {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		.pipeline li:not(:last-child)::after {
			top: 100%;
			left: 1.875rem;
			width: 1px;
			height: 1.5rem;
		}
		.pipeline li:not(:last-child)::before {
			top: calc(100% + 1.5rem - 8px);
			left: calc(1.875rem - 4px);
			border: 4.5px solid transparent;
			border-top: 7px solid var(--line);
		}
		.format {
			margin-left: 0;
		}
	}
</style>
