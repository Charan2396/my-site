---
import { stages, corruptSource } from '../lib/stages';
import { incidentSteps } from '../lib/incident';
import { url } from '../lib/url';

interface Props {
	/** First published story per stage; stages without one render as plain text, never a dead link. */
	storyByStage: Partial<Record<string, string>>;
}
const { storyByStage } = Astro.props;
const storyHref = (key: string) => (storyByStage[key] ? url(`stories/${storyByStage[key]}/`) : undefined);
// Samples mark the changed field with [[ ]]; odd split parts are the marked ones.
const parts = (text: string) => text.split(/\[\[|\]\]/);
const corruptLines = corruptSource.split('\n');
const sourceStory = storyHref('source');
---

<div class="record-view" data-record-view>
	<figure class="pipeline">
		<figcaption class="caption">
			One record's path through the platform. The <span class="chip-ref">4471/2</span> chip is the order line you're following.
			Simplified: the Pub/Sub broker reads the same mainframe change stream as the splitter.
		</figcaption>
		<ol>
			{
				stages.map((s, i) => {
					const href = storyHref(s.key);
					return (
						<li>
							<button class="pick" type="button" data-pick={i} aria-pressed={i === 0 ? 'true' : 'false'} hidden>
								<span class="sr-only">
									Show the record at stage {i + 1}, {s.label}
								</span>
							</button>
							<div class="stage card" data-stage transition:name={`stage-${s.key}`}>
								<span class="num" aria-hidden="true">{i + 1}</span>
								<span class="label">{s.label}</span>
								<span class="system">{s.system}</span>
								<span class="detail">{s.detail}</span>
								{s.key === 'process' && (
									<span class="flag" aria-hidden="true">
										✕ rejecting
									</span>
								)}
								{href && (
									<a class="cta" href={href}>
										Read the story<span class="sr-only">: {s.label} stage</span> →
									</a>
								)}
							</div>
						</li>
					);
				})
			}
		</ol>
		<span class="token mono" aria-hidden="true" data-token hidden>4471/2</span>
	</figure>

	<figure class="records">
		<div class="records-head">
			<figcaption class="caption">
				<strong>The same order line at each stage.</strong>
				<mark>Highlight</mark> = the changed field (qty 2 → 3). Illustrative data. Every byte checks: try decoding the base64.
			</figcaption>
			<div class="controls" data-controls hidden>
				<button class="btn" type="button" data-step="-1" aria-label="Previous stage">← Prev</button>
				<span class="count" data-count aria-hidden="true">1 / {stages.length}</span>
				<button class="btn" type="button" data-step="1" aria-label="Next stage">Next →</button>
			</div>
		</div>
		<p class="sr-only" aria-live="polite" data-live></p>
		<ol class="versions">
			{
				stages.map((s, i) => {
					const href = storyHref(s.key);
					return (
						<li class="card card-lg" data-version>
							<header>
								<span class="num" aria-hidden="true">{i + 1}</span>
								<h3>
									{s.label} <span>· {s.system}</span>
								</h3>
								<span class="format">{s.format}</span>
							</header>
							<pre tabindex="0" aria-label={`Sample record at the ${s.label} stage`}>{parts(s.sample).map((p, j) => (j % 2 ? <mark>{p}</mark> : p))}</pre>
							<p class="scroll-hint" aria-hidden="true" hidden>
								scroll →
							</p>
							{href && (
								<p class="story">
									<a href={href}>
										Read the story<span class="sr-only">: {s.label} stage</span> →
									</a>
								</p>
							)}
						</li>
					);
				})
			}
		</ol>
		<p class="swipe-hint caption" aria-hidden="true" hidden>Drag or swipe the record, or use the ← → keys.</p>
	</figure>

	<figure class="incident" data-incident>
		<figcaption class="eyebrow">Incident replay: one bad message</figcaption>
		<ol class="strip card" aria-hidden="true">
			{stages.map((_, i) => <li data-strip>{i + 1}</li>)}
		</ol>
		<p class="intro">
			A real incident from my work, step by step: one corrupt message made the splitter reject tens of thousands of
			messages, and this shows how it was caught and how the data was recovered.
		</p>
		<button class="start btn btn-primary" type="button" data-replay hidden>Watch one bad message break the pipeline (7 steps)</button>
		<div class="controls" data-icontrols hidden>
			<button class="btn" type="button" data-istep="-1">← Prev</button>
			<span class="count" data-icount aria-hidden="true">1 / {incidentSteps.length}</span>
			<button class="btn" type="button" data-istep="1">Next →</button>
			<button class="btn" type="button" data-play hidden>Play</button>
			<button class="btn" type="button" data-exit>Exit replay</button>
		</div>
		<ol class="steps" data-steps>
			{
				incidentSteps.map((st, i) => (
					<li class="card" data-step-item data-at={st.at} data-lit={(st.lit ?? [st.at]).join(' ')} data-error={st.error ? '' : undefined}>
						<header>
							<span class="num" aria-hidden="true">{i + 1}</span>
							<h3>{st.title}</h3>
						</header>
						<p>{st.caption}</p>
						{st.show === 'corrupt' && (
							<pre tabindex="0" aria-label="The corrupt Source record, with its uneven line breaks marked">{corruptLines.map((l, j) => (j < corruptLines.length - 1 ? [l, <mark>⏎</mark>, '\n'] : l))}</pre>
						)}
						{st.backlog && (
							<div class={`backlog is-${st.backlog}`}>
								<span class="bar" aria-hidden="true"><span /></span>
								<span>
									{st.backlog === 'drain' ? 'backlog drained: clean copies landed in Oracle' : 'tens of thousands of messages rejected'}
								</span>
							</div>
						)}
						{st.show === 'alert' && <pre class="alert">ALERT  missing rows: order_line not landing in Oracle</pre>}
						{st.show === 'keys' && (
							<pre>{`affected keys (order_id/line_no)
4471/2
4471/3
5502/1
…
→ fed back to the mainframe for regeneration`}</pre>
						)}
						{st.show === 'story' && sourceStory && (
							<p>
								<a href={sourceStory}>Read the full story →</a>
							</p>
						)}
					</li>
				))
			}
		</ol>
	</figure>
</div>

<script>
	import { onPage } from '../lib/stepper';
	import { createSpring, enter, project, rubberband, MOMENTUM, type Spring } from '../lib/spring';
	const GAP = 24; // px between panels while they slide

	onPage((signal) => {
		for (const root of document.querySelectorAll<HTMLElement>('[data-record-view]')) {
			const versions = [...root.querySelectorAll<HTMLElement>('[data-version]')];
			const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
			const boxes = [...root.querySelectorAll<HTMLElement>('[data-stage]')];
			const strip = [...root.querySelectorAll<HTMLElement>('[data-strip]')];
			const live = root.querySelector<HTMLElement>('[data-live]')!;
			const count = root.querySelector<HTMLElement>('[data-count]')!;
			const panel = root.querySelector<HTMLElement>('.records')!;
			const track = root.querySelector<HTMLElement>('.versions')!;
			const token = root.querySelector<HTMLElement>('[data-token]')!;
			const steps = [...root.querySelectorAll<HTMLElement>('[data-step-item]')];
			const stepList = root.querySelector<HTMLElement>('[data-steps]')!;
			const startBtn = root.querySelector<HTMLButtonElement>('[data-replay]')!;
			const iControls = root.querySelector<HTMLElement>('[data-icontrols]')!;
			const iCount = root.querySelector<HTMLElement>('[data-icount]')!;
			const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
			const iPrev = iControls.querySelector<HTMLButtonElement>('[data-istep="-1"]')!;
			const iNext = iControls.querySelector<HTMLButtonElement>('[data-istep="1"]')!;
			const pres = versions.map((v) => v.querySelector('pre')!);
			const reduced = matchMedia('(prefers-reduced-motion: reduce)');
			const n = versions.length;
			let current = 0;
			let step = -1; // -1 = not replaying
			let at = 0;
			let timer = 0;
			let stepAnim: Spring | undefined;

			// --- record token: two independent springs (x, y), retargeted mid-flight if the stage changes again
			const moveToken = () => (token.style.transform = `translate(${tx.value}px, ${ty.value}px)`);
			const tx = createSpring(moveToken, 0, 0.1);
			const ty = createSpring(moveToken, 0, 0.1);
			const place = (animate = true) => {
				const li = boxes[at].parentElement!;
				const x = li.offsetLeft + li.offsetWidth - token.offsetWidth - 12;
				const y = li.offsetTop - token.offsetHeight / 2;
				if (animate && !reduced.matches) tx.to(x), ty.to(y);
				else tx.set(x), ty.set(y);
			};
			const paint = (i: number, lit = [i], error = false) => {
				at = i;
				for (const els of [boxes, strip])
					els.forEach((b, j) => {
						b.classList.toggle('is-on', lit.includes(j));
						b.classList.toggle('is-error', error && j === 2);
					});
				place();
			};

			// --- fig. 2 carousel. `x` = how far the current panel sits from rest (px); one neighbour ("peer")
			// rides beside it at x + side * W. The logical state (hidden, aria, live text) changes at once;
			// the spring only moves pixels, so input is never locked out.
			let W = 0;
			let peer = -1;
			let side = 0;
			const measure = () => (W = track.clientWidth + GAP);
			const render = (x: number) => {
				if (reduced.matches) return;
				versions[current].style.transform = x ? `translate3d(${x}px, 0, 0)` : '';
				if (peer >= 0) versions[peer].style.transform = `translate3d(${x + side * W}px, 0, 0)`;
			};
			const dropPeer = () => {
				if (peer < 0) return;
				versions[peer].classList.remove('is-peek');
				root.classList.remove('is-sliding');
				versions[peer].style.transform = versions[peer].style.opacity = '';
				peer = -1;
			};
			const setPeer = (i: number, s: number, show = true) => {
				if (peer !== i) dropPeer();
				peer = i;
				side = s;
				versions[i].classList.toggle('is-peek', show);
				root.classList.toggle('is-sliding', show);
			};
			const slide = createSpring(render, 0, 0.5, dropPeer);
			// reduced motion: no travel, the two panels cross-fade in place
			const fade = createSpring(
				(f) => {
					versions[current].style.opacity = String(f);
					if (peer >= 0) versions[peer].style.opacity = String(1 - f);
				},
				1,
				0.001,
				() => ((versions[current].style.opacity = ''), dropPeer()),
			);

			// logical selection: what screen readers, tests and the token see
			const select = (i: number, announce = true) => {
				current = i;
				versions.forEach((v, j) => {
					v.hidden = j !== current;
					v.inert = j !== current;
				});
				picks.forEach((b, j) => b.setAttribute('aria-pressed', String(j === current)));
				count.textContent = `${current + 1} / ${n}`;
				if (step < 0) paint(current);
				hint(pres[current]);
				if (announce) live.textContent = `Stage ${current + 1} of ${n}: ${versions[current].querySelector('h3')!.textContent}`;
			};
			// move to stage i; the new panel comes in from side `dir` (+1 = from the right), carrying `velocity`
			const goTo = (i: number, dir: number, velocity?: number, params = {}) => {
				i = (i + n) % n;
				if (i === current) return select(i);
				const from = current;
				select(i);
				measure();
				if (reduced.matches) {
					slide.set(0);
					setPeer(from, 0);
					fade.set(0);
					return fade.to(1);
				}
				setPeer(from, -dir);
				slide.to(0, { shift: dir * W, velocity, ...params });
				render(slide.value);
			};

			// drag / swipe: hysteresis, then 1:1 from the grab point; release projects momentum to pick the stage
			type Drag = { id: number; x0: number; y0: number; base: number; live: boolean; hist: [number, number][] };
			let drag: Drag | null = null;
			track.addEventListener(
				'pointerdown',
				(e) => {
					if (e.button !== 0 || drag || (e.target as Element).closest('a, button')) return;
					slide.stop(); // catch it mid-flight, where it is on screen
					drag = { id: e.pointerId, x0: e.clientX, y0: e.clientY, base: slide.value, live: false, hist: [[e.timeStamp, e.clientX]] };
				},
				{ signal },
			);
			track.addEventListener(
				'pointermove',
				(e) => {
					if (!drag || e.pointerId !== drag.id) return;
					const dx = e.clientX - drag.x0, dy = e.clientY - drag.y0;
					if (!drag.live) {
						if (Math.hypot(dx, dy) < 10) return;
						if (Math.abs(dy) > Math.abs(dx)) return release(); // vertical: the page scrolls
						drag.live = true;
						drag.x0 = e.clientX; // start tracking here, so the panel doesn't jump by the threshold
						track.setPointerCapture(e.pointerId);
						root.classList.add('is-dragging');
						getSelection()?.removeAllRanges();
						measure();
					}
					drag.hist.push([e.timeStamp, e.clientX]);
					while (drag.hist.length > 2 && e.timeStamp - drag.hist[0][0] > 100) drag.hist.shift();
					let x = drag.base + e.clientX - drag.x0;
					const s = x < 0 ? 1 : -1;
					if (!(peer >= 0 && side === s)) {
						if (current + s >= 0 && current + s < n) setPeer(current + s, s, !reduced.matches); // reduced: nothing travels
						else dropPeer();
					}
					if (peer < 0) x = rubberband(x, W); // first or last stage: resist, don't stop dead
					else if (Math.abs(x) > W) x = Math.sign(x) * (W + rubberband(Math.abs(x) - W, W));
					slide.set(x);
				},
				{ signal },
			);
			const release = (e?: PointerEvent) => {
				const d = drag;
				drag = null;
				root.classList.remove('is-dragging');
				if (!d) return;
				if (!d.live || !e) return slide.to(0); // tap or vertical scroll: settle anything we interrupted
				const [t0, x0] = d.hist[0], [t1, x1] = d.hist[d.hist.length - 1];
				const v = t1 > t0 && e.timeStamp - t1 < 80 ? ((x1 - x0) / (t1 - t0)) * 1000 : 0;
				const x = slide.value, p = x + project(v);
				const params = Math.abs(v) > 300 ? MOMENTUM : {};
				// nearest rest point to where the gesture is heading: stay (x = 0) or the peer (x = -side * W)
				if (peer >= 0 && Math.abs(p + side * W) < Math.abs(p)) goTo(peer, side, v, params);
				else slide.to(0, { velocity: v, ...params });
			};
			track.addEventListener('pointerup', (e) => e.pointerId === drag?.id && release(e), { signal });
			track.addEventListener('pointercancel', (e) => e.pointerId === drag?.id && release(), { signal });

			// "scroll →" and a right-edge fade, only while the record box is wider than its frame and not scrolled to the end.
			// A record that scrolls sideways keeps native touch panning; the others hand horizontal swipes to the carousel.
			const hint = (pre: HTMLElement) => {
				const over = pre.scrollWidth > pre.clientWidth + 1;
				pre.classList.toggle('is-clipped', over && pre.scrollLeft + pre.clientWidth < pre.scrollWidth - 1);
				pre.style.touchAction = over ? 'pan-x pan-y' : 'pan-y';
				(pre.nextElementSibling as HTMLElement).hidden = !over;
			};
			for (const pre of pres) pre.addEventListener('scroll', () => hint(pre), { signal, passive: true });

			// --- fig. 3 incident replay
			const stopPlay = () => {
				clearInterval(timer);
				timer = 0;
				playBtn.textContent = 'Play';
			};
			const go = (k: number) => {
				const prev = step;
				step = Math.max(0, Math.min(steps.length - 1, k));
				stepAnim?.stop();
				steps.forEach((s, j) => {
					s.hidden = j !== step;
					s.style.opacity = s.style.transform = '';
				});
				if (step !== prev) stepAnim = enter(steps[step], prev < 0 ? 0 : Math.sign(step - prev), reduced.matches);
				const s = steps[step].dataset;
				paint(Number(s.at), s.lit ? s.lit.split(' ').map(Number) : [], 'error' in s);
				iCount.textContent = `${step + 1} / ${steps.length}`;
				// no wrap at the ends; a button that loses its use hands focus to the other one
				const f = document.activeElement;
				iPrev.disabled = step === 0;
				iNext.disabled = step === steps.length - 1;
				if ((f === iPrev || f === iNext) && f.disabled) (f === iPrev ? iNext : iPrev).focus();
				live.textContent = `Incident step ${step + 1} of ${steps.length}: ${steps[step].querySelector('h3')!.textContent}`;
				if (step === steps.length - 1) stopPlay();
			};
			const exitReplay = (focus = true) => {
				if (step < 0) return;
				stopPlay();
				step = -1;
				root.classList.remove('in-replay');
				stepList.hidden = iControls.hidden = true;
				startBtn.hidden = false;
				paint(current);
				live.textContent = `Replay closed. Stage ${current + 1} of ${n}.`;
				if (focus) startBtn.focus();
			};

			root.classList.add('is-stepper');
			for (const el of [...picks, root.querySelector<HTMLElement>('[data-controls]')!, root.querySelector<HTMLElement>('.swipe-hint')!, startBtn, token]) el.hidden = false;
			stepList.hidden = true;
			const syncPlay = () => (playBtn.hidden = reduced.matches);
			syncPlay();
			reduced.addEventListener('change', () => (stopPlay(), syncPlay()), { signal });
			signal.addEventListener('abort', () => (stopPlay(), slide.stop(), fade.stop(), tx.stop(), ty.stop(), stepAnim?.stop()));

			picks.forEach((b, j) =>
				b.addEventListener('click', () => {
					exitReplay(false);
					goTo(j, Math.sign(j - current) || 1);
					// on narrow screens the panel sits below the stacked stages
					panel.scrollIntoView({ block: 'nearest', behavior: reduced.matches ? 'auto' : 'smooth' });
				}),
			);
			for (const b of root.querySelectorAll<HTMLButtonElement>('[data-step]'))
				b.addEventListener('click', () => {
					const d = Number(b.dataset.step);
					exitReplay(false);
					goTo(current + d, d);
				});
			for (const b of root.querySelectorAll<HTMLButtonElement>('[data-istep]'))
				b.addEventListener('click', () => (stopPlay(), go(step + Number(b.dataset.istep))));
			startBtn.addEventListener('click', () => {
				root.classList.add('in-replay');
				startBtn.hidden = true;
				stepList.hidden = iControls.hidden = false;
				go(0);
				iNext.focus();
			});
			root.querySelector('[data-exit]')!.addEventListener('click', () => exitReplay());
			playBtn.addEventListener('click', () => {
				if (timer) return stopPlay();
				if (reduced.matches) return;
				if (step === steps.length - 1) go(0);
				playBtn.textContent = 'Pause';
				timer = window.setInterval(() => go(step + 1), 2000);
			});
			root.addEventListener('keydown', (e) => {
				// leave arrows alone inside scrollable record boxes
				if (e.altKey || e.ctrlKey || e.metaKey || (e.target as HTMLElement).closest('pre')) return;
				if (e.key === 'Escape' && step >= 0) return exitReplay();
				if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
				e.preventDefault();
				const d = e.key === 'ArrowRight' ? 1 : -1;
				if (step >= 0) return stopPlay(), go(step + d);
				goTo(current + d, d);
				if (picks.includes(document.activeElement as HTMLButtonElement)) picks[current].focus();
			});
			addEventListener('resize', () => (slide.set(0), dropPeer(), place(false), hint(pres[current])), { signal });
			document.fonts?.ready.then(() => place(false));
			select(0, false);
			place(false); // first placement without a slide; later moves ride the springs
		}
	});
</script>

<style>
	.record-view {
		display: grid;
		gap: 4.5rem;
	}
	figure {
		margin: 0;
		min-width: 0;
	}
	figcaption {
		max-width: var(--measure);
		margin-bottom: 1.5rem;
	}
	figcaption strong {
		color: var(--ink);
		font-weight: 600;
	}
	mark {
		padding: 0 0.15em;
		border-radius: 0.2em;
		background: color-mix(in srgb, var(--accent) 18%, transparent);
		color: inherit;
		box-shadow: inset 0 -2px 0 var(--accent);
	}
	.chip-ref {
		padding: 0.05em 0.45em;
		border-radius: 999px;
		background: var(--accent-fill);
		color: var(--on-accent);
		font: 600 0.8em var(--font-mono);
	}
	.num {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.625rem;
		height: 1.625rem;
		border-radius: 50%;
		background: var(--fill-strong);
		color: var(--ink);
		font-size: 0.8125rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	/* the five stages: elevated cards joined by a thin line and chevron */
	.pipeline {
		position: relative;
		--gap: 2rem;
		--connector: color-mix(in srgb, var(--muted) 55%, transparent);
	}
	.pipeline ol {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: var(--gap);
		margin: 0;
		padding: 0.875rem 0 0;
		list-style: none;
	}
	.pipeline li {
		position: relative;
		display: flex;
	}
	.pipeline li:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 100%;
		width: calc(var(--gap) - 3px);
		height: 1.5px;
		background: var(--connector);
	}
	.pipeline li:not(:last-child)::before {
		content: '';
		position: absolute;
		top: 50%;
		left: calc(100% + var(--gap) - 9px);
		width: 0.5rem;
		height: 0.5rem;
		margin-top: -0.25rem;
		border-top: 1.5px solid var(--connector);
		border-right: 1.5px solid var(--connector);
		transform: rotate(45deg);
	}
	.stage {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		width: 100%;
		padding: 1.125rem 1.125rem 1rem;
		color: var(--ink);
		/* the card (a stacking context: view-transition-name, press scale) sits above the .pick button but
		   lets clicks through to it; only the story link takes the pointer */
		position: relative;
		z-index: 3;
		pointer-events: none;
		transition:
			transform 100ms ease-out,
			box-shadow 0.2s ease,
			background-color 0.2s ease;
	}
	.pick:hover + .stage {
