---
import StepControls from './StepControls.astro';
import { reconSteps, SOURCE } from '../lib/recon';

const tag = { ok: '', missing: 'missing', stale: 'stale', deleted: 'deleted', fixed: 'resent' } as const;
---

<figure class="recon" data-stepper>
	<figcaption class="caption">Reconciliation across three instances. Invented sample data, table ORDER_LINE.</figcaption>
	<StepControls total={reconSteps.length} />
	<ol class="steps">
		{
			reconSteps.map((st, i) => (
				<li class="card" data-step-item>
					<header>
						<span class="num" aria-hidden="true">{i + 1}</span>
						<h3>{st.title}</h3>
					</header>
					<p class="caption">{st.caption}</p>
					<div class="board">
						{st.cols.map((c) => (
							<section class="inst" aria-label={`Instance ${c.inst}`}>
								<h4>
									Instance {c.inst} <span>· {c.inst === SOURCE ? 'source' : 'target'}</span>
								</h4>
								<ul class="rows mono">
									{c.list.map((r) => (
										<li class:list={['row', `is-${r.state}`]}>
											<span>{r.key}</span>
											{tag[r.state] && <span class="tag">{tag[r.state]}</span>}
										</li>
									))}
								</ul>
								{st.compare ? (
									<ul class="fps mono" aria-label={`Fingerprints, Instance ${c.inst}`}>
										{c.fps.map((f) => (
											<li class:list={['fp', { 'is-error': f.fullDiff || f.recentDiff }]}>
												<span class="co">company {f.co}</span>
												<span class:list={{ diff: f.fullDiff }}>
													full {f.full}
													{f.fullDiff && <span class="ne"> ≠ A</span>}
												</span>
												<span class:list={{ diff: f.recentDiff }}>
													30d {f.recent}
													{f.recentDiff && <span class="ne"> ≠ A</span>}
												</span>
											</li>
										))}
									</ul>
								) : (
									<p class="fp-none">not fingerprinted yet</p>
								)}
							</section>
						))}
					</div>
					<div class:list={['panel', { 'is-error': st.drift.length > 0, 'is-clean': st.compare && !st.drift.length }]}>
						<h4>Drift classification</h4>
						{!st.compare ? (
							<p>Not compared yet.</p>
						) : st.drift.length === 0 ? (
							<p>Zero difference: every fingerprint in B and C matches A.</p>
						) : (
							<ul>
								{st.drift.map((d) => (
									<li class="drift">
										<strong>
											Instance {d.inst} · company {d.co} · {d.kind}
										</strong>{' '}
										({d.detail})
										{st.drill && (
											<span class="keys mono">
												{d.kind === 'missing in target' ? 'in A, not in ' : 'not in A, still in '}
												{d.inst}: {d.keys.join(', ')}
											</span>
										)}
									</li>
								))}
							</ul>
						)}
					</div>
				</li>
			))
		}
	</ol>
</figure>

<script>
	import { initSteppers, onPage } from '../lib/stepper';
	onPage(initSteppers);
</script>

<style>
	figure {
		margin: 0;
		min-width: 0;
	}
	figcaption {
		margin-bottom: 1rem;
	}
	.steps {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.steps > li[hidden] {
		display: none;
	}
	.steps > li {
		min-width: 0;
		padding: 1.25rem 1.5rem 1.5rem;
	}
	header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.num {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.625rem;
		height: 1.625rem;
		border-radius: 50%;
		background: var(--accent-fill);
		color: var(--on-accent);
		font-size: 0.8125rem;
		font-weight: 600;
	}
	h3 {
		margin: 0;
		font-size: 1.0625rem;
	}
	.caption {
		max-width: var(--measure);
		margin: 0.625rem 0 1.25rem;
		color: var(--ink);
		font-size: 1rem;
	}
	h4 {
		margin: 0 0 0.625rem;
		color: var(--ink);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.005em;
	}
	h4 span {
		color: var(--muted);
		font-weight: 400;
	}
	.board {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	/* inner wells: filled, not outlined, so the card stays one surface */
	.inst {
		min-width: 0;
		padding: 0.875rem;
		border-radius: var(--radius);
		background: var(--code-bg);
	}
	.rows,
	.fps {
		display: grid;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.8125rem;
	}
	.row {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.1875rem 0.5rem;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		background: var(--surface);
	}
	.tag {
		font-size: 0.75rem;
		font-weight: 600;
	}
	.row.is-missing,
	.row.is-stale {
		border-color: var(--error);
		background: var(--error-bg);
		color: var(--error);
	}
	/* dashed = a row that isn't there (missing or deleted); the only dashed lines, and they carry meaning */
	.row.is-missing {
		border-style: dashed;
	}
	.row.is-missing > span:first-child,
	.row.is-deleted > span:first-child {
		text-decoration: line-through;
	}
	.row.is-deleted {
		border: 1px dashed var(--rule);
		background: none;
		color: var(--muted);
	}
	.row.is-fixed {
		border-color: var(--accent);
		background: var(--tint);
		color: var(--accent);
	}
	.fps {
		margin-top: 0.875rem;
		padding-top: 0.875rem;
		border-top: 1px solid var(--rule);
		gap: 0.5rem;
	}
	.fp {
		display: grid;
		padding-left: 0.625rem;
		border-left: 3px solid var(--accent);
		color: var(--muted);
	}
	.fp .co {
		color: var(--ink);
	}
	.fp.is-error {
		border-left-color: var(--error);
	}
	.fp .diff {
		color: var(--error);
		font-weight: 600;
	}
	.fp-none {
		margin: 0.875rem 0 0;
		padding-top: 0.875rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.8125rem;
	}
	.panel {
		margin-top: 1rem;
		padding: 0.875rem 1.125rem;
		border-radius: var(--radius);
		background: var(--code-bg);
	}
	.panel.is-error {
		background: var(--error-bg);
		box-shadow: inset 3px 0 0 var(--error);
	}
	.panel.is-error h4 {
		color: var(--error);
	}
	.panel.is-clean {
		box-shadow: inset 3px 0 0 var(--accent);
	}
	.panel p,
	.panel ul {
		margin: 0;
	}
	.panel ul {
		display: grid;
		gap: 0.5rem;
		padding-left: 1.25rem;
	}
	.keys {
		display: block;
		margin-top: 0.125rem;
		font-size: 0.8125rem;
	}
	@media (max-width: 48rem) {
		.board {
			grid-template-columns: 1fr;
		}
		.steps > li {
			padding: 1rem;
		}
	}
</style>
