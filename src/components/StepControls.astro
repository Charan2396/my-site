---
// Prev/Next controls and the aria-live region for an explainer stepper (see src/lib/stepper.ts).
interface Props {
	total: number;
}
const { total } = Astro.props;
---

<div class="controls" data-controls hidden>
	<button class="btn" type="button" data-go="-1">← Prev</button>
	<span class="count" data-count aria-hidden="true">1 / {total}</span>
	<button class="btn" type="button" data-go="1">Next →</button>
	<span class="hint">or use the ← → keys</span>
</div>
<p class="sr-only" aria-live="polite" data-live></p>

<style>
	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	.controls[hidden] {
		display: none;
	}
	.count {
		min-width: 3.25rem;
		color: var(--muted);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		text-align: center;
	}
	.hint {
		margin-left: 0.5rem;
		color: var(--muted);
		font-size: 0.8125rem;
	}
</style>
