---
// Trade-off explorer for /designs/store-and-forward/: Direct vs Store-and-forward under a planned outage.
// Without JS: a static comparison table. With JS: a segmented control, an outage toggle and a lane whose
// queue backlog grows (spring) during the outage and drains after it. Illustrative only: no message counts.
const msgs = [1, 2, 3, 4, 5];
---

<section class="sf card" data-sf aria-labelledby="sf-title">
	<h2 id="sf-title">Try it: a planned outage</h2>
	<p class="caption">Illustrative. Switch the design, then take the destination down for planned maintenance.</p>

	<div class="controls" data-controls hidden>
		<div class="seg" role="group" aria-label="Design">
			<button type="button" data-mode="direct" aria-pressed="true">Direct</button>
			<button type="button" data-mode="sf" aria-pressed="false">Store-and-forward</button>
		</div>
		<button type="button" class="btn outage" data-outage aria-pressed="false">
			<span class="switch" aria-hidden="true"></span>Planned outage
		</button>
	</div>

	<div class="lane is-direct" data-lane hidden aria-hidden="true">
		<div class="node">Sender</div>
		<div class="link"></div>
		<div class="node queue" data-queue>
			Queue <span class="sub">IBM MQ</span>
			<div class="bar"><span data-bar></span></div>
		</div>
		<div class="link q"></div>
		<div class="node dest" data-dest>Destination <span class="sub" data-dest-state>up</span></div>
	</div>
	<ul class="msgs is-ok" data-msgs hidden aria-hidden="true">
		{msgs.map(() => <li class="msg" />)}
	</ul>
	<p class="status" data-live aria-live="polite"></p>

	<table data-fallback>
		<caption class="caption">How the two patterns behave during a planned outage on the destination</caption>
		<thead>
			<tr><th scope="col"></th><th scope="col">Direct</th><th scope="col">Store-and-forward</th></tr>
		</thead>
		<tbody>
			<tr>
				<th scope="row">Messages sent during the outage</th>
				<td class="bad">Rejected — the destination is down</td>
				<td>Stored in the queue</td>
			</tr>
			<tr>
				<th scope="row">When the outage ends</th>
				<td>New messages are accepted again; the rejected ones were not delivered</td>
				<td>The queue forwards the stored messages and the backlog drains</td>
			</tr>
		</tbody>
	</table>

	<p class="outcome">Real outcome: over 90% less planned-downtime exposure, reusing existing infrastructure.</p>
</section>

<script>
	import { createSpring, type Spring } from '../lib/spring';
	import { onPage } from '../lib/stepper';

	const text = {
		direct: 'Direct: messages go straight to the destination, and it accepts them.',
		directDown: 'Direct, planned outage: messages are rejected — the destination is down.',
		sf: 'Store-and-forward: messages pass through the queue to the destination.',
		sfDown: 'Store-and-forward, planned outage: messages are stored in the queue while the destination is down.',
		sfDrain: 'Store-and-forward, outage over: the queue forwards the stored messages and the backlog drains.',
	};

	onPage((signal) => {
		for (const root of document.querySelectorAll<HTMLElement>('[data-sf]')) {
			const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
			const modes = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
			const outageBtn = $<HTMLButtonElement>('[data-outage]');
			const lane = $('[data-lane]'), msgs = $('[data-msgs]'), live = $('[data-live]'), bar = $('[data-bar]');
			const destState = $('[data-dest-state]');
			const reduced = matchMedia('(prefers-reduced-motion: reduce)');
			let mode: 'direct' | 'sf' = 'direct';
			let outage = false;
			let backlog = false; // store-and-forward held messages during this outage
			const spring: Spring = createSpring((v) => (bar.style.transform = `scaleX(${v})`), 0, 0.002);
			signal.addEventListener('abort', () => spring.stop());

			const render = (announce = true) => {
				const was = backlog;
				for (const b of modes) b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
				outageBtn.setAttribute('aria-pressed', String(outage));
				backlog = mode === 'sf' && outage;
				const state = mode === 'direct' ? (outage ? 'fail' : 'ok') : outage ? 'held' : 'ok';
				lane.classList.toggle('is-direct', mode === 'direct');
				lane.classList.toggle('is-down', outage);
				msgs.className = `msgs is-${state}`;
				destState.textContent = outage ? 'down' : 'up';
				// the backlog grows while the outage lasts and drains when it ends; reduced motion jumps
				const target = backlog ? 1 : 0;
				if (reduced.matches || mode === 'direct') spring.set(target);
				else spring.to(target, { response: target ? 1.2 : 0.8 });
				if (!announce) return;
				live.textContent =
					mode === 'direct' ? (outage ? text.directDown : text.direct) : outage ? text.sfDown : was ? text.sfDrain : text.sf;
			};

			for (const b of modes)
				b.addEventListener('click', () => ((mode = b.dataset.mode as typeof mode), render()), { signal });
			// arrow keys move between the two segments
			$('.seg').addEventListener(
				'keydown',
				(e) => {
					if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
					e.preventDefault();
					const next = modes[e.key === 'ArrowRight' ? 1 : 0];
					next.focus();
					mode = next.dataset.mode as typeof mode;
					render();
				},
				{ signal },
			);
			outageBtn.addEventListener('click', () => ((outage = !outage), render()), { signal });

			$('[data-controls]').hidden = lane.hidden = msgs.hidden = false;
			$('[data-fallback]').hidden = true;
			render(false);
			live.textContent = text.direct;
		}
	});
</script>

<style>
	.sf {
		margin-top: 3rem;
		padding: 1.5rem 1.375rem;
		box-shadow: var(--shadow-sm);
	}
	h2 {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	.caption {
		margin: 0.375rem 0 0;
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}
	.controls[hidden],
	.lane[hidden],
	.msgs[hidden],
	table[hidden] {
		display: none;
	}
	/* segmented control */
	.seg {
		display: inline-flex;
		padding: 0.1875rem;
		border-radius: 999px;
		background: var(--fill);
	}
	.seg button {
		min-height: 2.25rem;
		padding: 0.375rem 0.875rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--ink);
		font: 600 var(--text-sm)/1.2 var(--font-sans);
		cursor: pointer;
	}
	.seg button[aria-pressed='true'] {
		background: var(--surface);
		color: var(--accent);
		box-shadow: var(--shadow-sm);
	}
	.outage {
		color: var(--ink);
	}
	.switch {
		position: relative;
		width: 2rem;
		height: 1.125rem;
		border-radius: 999px;
		background: var(--fill-strong);
		transition: background-color 0.2s ease;
	}
	.switch::after {
		content: '';
		position: absolute;
		top: 0.125rem;
		left: 0.125rem;
		width: 0.875rem;
		height: 0.875rem;
		border-radius: 50%;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease;
	}
	.outage[aria-pressed='true'] .switch {
		background: var(--error);
	}
	.outage[aria-pressed='true'] .switch::after {
		transform: translateX(0.875rem);
	}

	/* the lane: sender -> (queue) -> destination */
	.lane {
		display: grid;
		grid-template-columns: auto 1fr auto 1fr auto;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}
	.lane.is-direct {
		grid-template-columns: auto 1fr auto;
	}
	.lane.is-direct .queue,
	.lane.is-direct .q {
		display: none;
	}
	.node {
		padding: 0.625rem 0.75rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--surface);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.3;
		transition: var(--theme-ease);
	}
	.sub {
		display: block;
		color: var(--muted);
		font-size: var(--text-xs);
		font-weight: 500;
	}
	.link {
		height: 2px;
		min-width: 1rem;
		border-radius: 1px;
		background: var(--rule);
	}
	.queue {
		min-width: 7rem;
	}
	.bar {
		height: 0.5rem;
		margin-top: 0.375rem;
		overflow: hidden;
		border-radius: 999px;
		background: var(--fill);
	}
	.bar span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--accent-fill);
		transform: scaleX(0);
		transform-origin: left;
	}
	.lane.is-down .dest {
		border-color: var(--error);
		background: var(--error-bg);
		color: var(--error);
	}
	.lane.is-down .dest .sub {
		color: var(--error);
	}

	/* the messages being sent */
	.msgs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.msg {
		width: 2.25rem;
		height: 1.375rem;
		border: 1px solid transparent;
		border-radius: 999px;
		background: var(--tint);
		transition: var(--theme-ease);
	}
	.msgs.is-fail .msg {
		border-color: var(--error);
		background: var(--error-bg);
	}
	.msgs.is-held .msg {
		border: 1px dashed var(--accent);
		background: transparent;
	}
	.status {
		min-height: 3em;
		margin: 0.75rem 0 0;
		font-weight: 600;
	}
	.msgs.is-fail + .status {
		color: var(--error);
	}

	table {
		width: 100%;
		margin-top: 1.25rem;
		border-collapse: collapse;
		font-size: var(--text-sm);
		line-height: 1.4;
	}
	caption {
		text-align: left;
		margin-bottom: 0.5rem;
	}
	th,
	td {
		padding: 0.625rem 0.5rem 0.625rem 0;
		border-top: 1px solid var(--rule);
		text-align: left;
		vertical-align: top;
	}
	thead th {
		border-top: 0;
	}
	.bad {
		color: var(--error);
	}
	.outcome {
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: var(--text-sm);
	}
	/* narrow phones: the five-column lane must fit a 390px screen */
	@media (max-width: 30rem) {
		.lane {
			gap: 0.375rem;
		}
		.node {
			padding: 0.5rem 0.5625rem;
			font-size: var(--text-sm);
		}
		.queue {
			min-width: 0;
		}
		.link {
			min-width: 0.5rem;
		}
	}
</style>
