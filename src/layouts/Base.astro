---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
	title?: string;
	description?: string;
}

const name = 'Sricharan Anand';
const {
	title,
	description = 'Senior Data Platform Engineer: real-time data replication, enterprise messaging and data reconciliation.',
} = Astro.props;

// Links are added only when their page ships, so the live site never has dead links.
const nav = [
	{ href: 'working-with-me/', label: 'Working with me' },
	{ href: 'projects/', label: 'Projects' },
	{ href: 'resume/', label: 'Resume' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title ? `${title} · ${name}` : name}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
		<link rel="icon" href={url('favicon.ico')} />
		<ClientRouter />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="wrap bar">
				<a class="brand press" href={url()} aria-label={`${name}, home`}>SA</a>
				{nav.length > 0 && (
					<nav aria-label="Main">
						<ul>
							{nav.map(({ href, label }) => (
								<li>
									<a href={url(href)} aria-current={current === url(href).replace(/\/$/, '') ? 'page' : undefined}>
										{label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)}
			</div>
		</header>

		<main id="main" class="wrap">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap bar">
				<span>© {new Date().getFullYear()} {name}</span>
				<nav aria-label="Footer">
					<ul>
						<li><a href="mailto:sricharan23@gmail.com">Email</a></li>
						<li><a href="https://linkedin.com/in/charansri">LinkedIn</a></li>
						<li><a href="https://github.com/Charan2396">GitHub</a></li>
						<li>
							<a href={url('build-log/')} aria-current={current === url('build-log/').replace(/\/$/, '') ? 'page' : undefined}>Build log</a>
						</li>
					</ul>
				</nav>
			</div>
		</footer>
	</body>
</html>

<style>
	/* translucent material: content scrolls under it; a soft scroll-edge fade replaces a hard divider */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--material);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		backdrop-filter: blur(20px) saturate(180%);
		transition: var(--theme-ease);
	}
	.site-header::after {
		content: '';
		position: absolute;
		inset: 100% 0 auto;
		height: 0.75rem;
		background: linear-gradient(var(--edge), transparent);
		pointer-events: none;
	}
	@media (prefers-reduced-transparency: reduce) {
		.site-header {
			background: var(--bg);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}
	@media (prefers-contrast: more) {
		.site-header {
			background: var(--bg);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			border-bottom: 1px solid var(--rule);
		}
		.site-header::after {
			display: none;
		}
	}
	.site-header .bar {
		min-height: var(--header-h);
		padding-block: 0.375rem;
	}
	.site-footer {
		margin-top: auto;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.8125rem;
		letter-spacing: 0.005em;
	}
	.site-footer .bar {
		padding-block: 1.5rem 2rem;
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}
	.bar ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* monogram, so the name isn't repeated next to page h1s */
	.brand {
		display: grid;
		place-items: center;
		width: 2.125rem;
		height: 2.125rem;
		border-radius: 50%;
		background: var(--ink);
		color: var(--bg);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-decoration: none;
	}
	.brand:hover {
		text-decoration: none;
		background: var(--accent-fill);
		color: var(--on-accent);
	}
	/* wayfinding: the current page is a filled pill, not just a colour */
	.site-header nav ul {
		gap: 0.25rem;
	}
	.site-header nav a {
		display: block;
		padding: 0.375rem 0.75rem;
		border-radius: 999px;
		color: var(--ink);
		font-size: 0.875rem;
		letter-spacing: 0.005em;
		text-decoration: none;
	}
	.site-header nav a:hover {
		background: var(--fill);
	}
	.site-header nav a[aria-current='page'] {
		background: var(--fill-strong);
		font-weight: 600;
	}
	.site-footer a {
		color: var(--muted);
	}
	.site-footer a:hover,
	.site-footer a[aria-current='page'] {
		color: var(--ink);
	}
	.site-footer a[aria-current='page'] {
		font-weight: 600;
	}
	main {
		padding-block: 3rem 5rem;
	}
	@media (min-width: 48rem) {
		main {
			padding-block: 4.5rem 6rem;
		}
	}
	/* Keep the three nav links on one line next to the monogram on a 390px phone. */
	@media (max-width: 30rem) {
		.site-header nav a {
			padding-inline: 0.5rem;
			font-size: 0.8125rem;
		}
	}
</style>
