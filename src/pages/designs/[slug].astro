---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gloss from '../../components/Gloss.astro';
import StoreForwardToggle from '../../components/StoreForwardToggle.astro';
import { getDesigns } from '../../lib/designs';
import { resolveRelated } from '../../lib/related';
import { stages } from '../../lib/stages';
import { url } from '../../lib/url';

export async function getStaticPaths() {
	return (await getDesigns()).map((design) => ({ params: { slug: design.id }, props: { design } }));
}

const { design } = Astro.props;
const d = design.data;
const { Content } = await render(design);
const stage = stages.find((s) => s.key === d.stage);
const related = await resolveRelated(d.related);
const nonGoals = d.nonGoals ?? [];
const options = d.options ?? [];
// a design's optional sections, as [id, heading, items]; each renders only when filled in
const list = (id: string, title: string, items?: string[]) => ({ id, title, items: items ?? [] });
const why = list('why', 'Why this approach', d.why);
const guards = list('guards', 'What it guards against', d.guardsAgainst);
const limits = list('limits', 'Known limits', d.knownLimits);
const wentWrong = (d.wentWrong ?? []).map((w) => ({ ...w, href: w.href && url(w.href) }));
---

<Base title={d.title} description={d.summary}>
	<article>
		{
			stage ? (
				<header transition:name={`stage-${stage.key}`}>
					<p class="eyebrow">Design doc · {stage.label} stage · {stage.system}</p>
					<h1>{d.title}</h1>
				</header>
			) : (
				<header>
					<p class="eyebrow">Design doc</p>
					<h1>{d.title}</h1>
				</header>
			)
		}
		<p class="lede">
			<Gloss text={d.summary} />
		</p>

		<section aria-labelledby="problem">
			<h2 id="problem">Problem</h2>
			<p>{d.problem}</p>
		</section>

		{
			d.whoItServes && (
				<section aria-labelledby="serves">
					<h2 id="serves">Who it serves</h2>
					<p>{d.whoItServes}</p>
				</section>
			)
		}

		{
			d.constraints.length > 0 && (
				<section aria-labelledby="constraints">
					<h2 id="constraints">Constraints</h2>
					<ul class="list">
						{d.constraints.map((c) => (
							<li>{c}</li>
						))}
					</ul>
				</section>
			)
		}

		{
			options.length > 0 && (
				<section aria-labelledby="options">
					<h2 id="options">Options considered</h2>
					<ul class="list">
						{options.map((o) => (
							<li>{o}</li>
						))}
					</ul>
				</section>
			)
		}

		{
			why.items.length > 0 && (
				<section aria-labelledby={why.id}>
					<h2 id={why.id}>{why.title}</h2>
					<ul class="list">
						{why.items.map((t) => (
							<li>{t}</li>
						))}
					</ul>
				</section>
			)
		}

		<section aria-labelledby="decision">
			<h2 id="decision">Decision</h2>
			<div class="decision card">
				{d.status && <p class="status">Status: {d.status}</p>}
				<p>{d.decision}</p>
				{d.revisit && <p class="revisit">{d.revisit}</p>}
			</div>
		</section>

		{design.id === 'store-and-forward' && <StoreForwardToggle />}

		{
			(d.tradeoffs || nonGoals.length > 0) && (
				<section aria-labelledby="tradeoffs">
					<h2 id="tradeoffs">Trade-offs &amp; non-goals</h2>
					{d.tradeoffs && <p>{d.tradeoffs}</p>}
					{nonGoals.length > 0 && (
						<ul class="list">
							{nonGoals.map((n) => (
								<li>Not a goal: {n}</li>
							))}
						</ul>
					)}
				</section>
			)
		}

		{
			[guards, limits]
				.filter((x) => x.items.length > 0)
				.map((x) => (
					<section aria-labelledby={x.id}>
						<h2 id={x.id}>{x.title}</h2>
						<ul class="list">
							{x.items.map((t) => (
								<li>{t}</li>
							))}
						</ul>
					</section>
				))
		}

		<section aria-labelledby="outcome">
			<h2 id="outcome">Outcome</h2>
			<p>{d.outcome}</p>
		</section>

		{
			d.heldUp && (
				<section aria-labelledby="held-up">
					<h2 id="held-up">How it held up</h2>
					<p>{d.heldUp}</p>
				</section>
			)
		}

		{
			wentWrong.length > 0 && (
				<section aria-labelledby="went-wrong">
					<h2 id="went-wrong">What went wrong along the way</h2>
					<ul class="list">
						{wentWrong.map((w) => (
							<li>
								{w.text}
								{w.href && (
									<>
										{' '}
										<a href={w.href}>{w.link}&nbsp;→</a>
									</>
								)}
							</li>
						))}
					</ul>
				</section>
			)
		}

		{design.body?.trim() && <div class="prose takeaway"><Content /></div>}

		{
			related.length > 0 && (
				<section aria-labelledby="related">
					<h2 id="related">Related</h2>
					<ul class="list related">
						{related.map((r) => (
							<li>
								<a href={r.href}>{r.label}&nbsp;→</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<p class="back"><a class="btn press" href={url('designs/')}>← All designs</a></p>
	</article>
</Base>

<style>
	article {
		max-width: 48rem;
	}
	h1 {
		max-width: var(--measure);
		margin-block: 0.75rem 1.25rem;
	}
	.lede {
		margin: 0;
		color: var(--muted);
	}
	section,
	.prose {
		margin-top: 3rem;
	}
	h2 {
		margin-block: 0 0.875rem;
		font-size: var(--text-xl);
	}
	section p,
	.list {
		max-width: var(--measure);
		margin: 0;
	}
	.list {
		padding-left: 1.25rem;
	}
	.list li + li {
		margin-top: 0.375rem;
	}
	.related {
		padding: 0;
		list-style: none;
		font-weight: 600;
	}
	.decision {
		max-width: var(--measure);
		padding: 1.25rem 1.375rem;
		background: var(--tint);
		box-shadow: var(--shadow-sm);
	}
	.decision .status {
		margin-bottom: 0.5rem;
		color: var(--accent);
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.decision .revisit {
		margin-top: 0.875rem;
		color: var(--muted);
		font-size: var(--text-sm);
	}
	/* the one-sentence takeaway */
	.takeaway {
		max-width: var(--measure);
		padding-left: 1rem;
		border-left: 3px solid var(--accent-fill);
		font-weight: 600;
	}
	.takeaway :global(p) {
		margin: 0;
	}
	.back {
		margin-top: 3.5rem;
	}
</style>
