---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gloss from '../../components/Gloss.astro';
import StoreForwardToggle from '../../components/StoreForwardToggle.astro';
import { getDesigns } from '../../lib/designs';
import { resolveRelated } from '../../lib/related';
import { stages } from '../../lib/stages';
import { url } from '../../lib/url';

export async function getStaticPaths() {
	return (await getDesigns()).map((design) => ({ params: { slug: design.id }, props: { design } }));
}

const { design } = Astro.props;
const d = design.data;
const { Content } = await render(design);
const stage = stages.find((s) => s.key === d.stage);
const related = await resolveRelated(d.related);
const nonGoals = d.nonGoals ?? [];
const options = d.options ?? [];
---

<Base title={d.title} description={d.summary}>
	<article>
		{
			stage ? (
				<header transition:name={`stage-${stage.key}`}>
					<p class="eyebrow">Design doc · {stage.label} stage · {stage.system}</p>
					<h1>{d.title}</h1>
				</header>
			) : (
				<header>
					<p class="eyebrow">Design doc</p>
					<h1>{d.title}</h1>
				</header>
			)
		}
		<p class="lede">
			<Gloss text={d.summary} />
		</p>
		<p class="proof"><span class="card">{d.proof}</span></p>

		<section aria-labelledby="problem">
			<h2 id="problem">Problem</h2>
			<p>{d.problem}</p>
		</section>

		{
			d.constraints.length > 0 && (
				<section aria-labelledby="constraints">
					<h2 id="constraints">Constraints</h2>
					<ul class="list">
						{d.constraints.map((c) => (
							<li>{c}</li>
						))}
					</ul>
				</section>
			)
		}

		{
			options.length > 0 && (
				<section aria-labelledby="options">
					<h2 id="options">Options considered</h2>
					<ul class="list">
						{options.map((o) => (
							<li>{o}</li>
						))}
					</ul>
				</section>
			)
		}

		<section aria-labelledby="decision">
			<h2 id="decision">Decision</h2>
			<p class="decision card">{d.decision}</p>
		</section>

		{design.id === 'store-and-forward' && <StoreForwardToggle />}

		{
			(d.tradeoffs || nonGoals.length > 0) && (
				<section aria-labelledby="tradeoffs">
					<h2 id="tradeoffs">Trade-offs &amp; non-goals</h2>
					{d.tradeoffs && <p>{d.tradeoffs}</p>}
					{nonGoals.length > 0 && (
						<ul class="list">
							{nonGoals.map((n) => (
								<li>Not a goal: {n}</li>
							))}
						</ul>
					)}
				</section>
			)
		}

		<section aria-labelledby="outcome">
			<h2 id="outcome">Outcome</h2>
			<p>{d.outcome}</p>
		</section>

		{
			d.heldUp && (
				<section aria-labelledby="held-up">
					<h2 id="held-up">How it held up</h2>
					<p>{d.heldUp}</p>
				</section>
			)
		}

		{design.body?.trim() && <div class="prose"><Content /></div>}

		{
			related.length > 0 && (
				<section aria-labelledby="related">
					<h2 id="related">Related</h2>
					<ul class="list related">
						{related.map((r) => (
							<li>
								<a href={r.href}>{r.label}&nbsp;→</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<p class="back"><a class="btn press" href={url('designs/')}>← All designs</a></p>
	</article>
</Base>

<style>
	article {
		max-width: 48rem;
	}
	h1 {
		max-width: var(--measure);
		margin-block: 0.75rem 1.25rem;
	}
	.lede {
		margin: 0;
		color: var(--muted);
	}
	.proof {
		margin: 1.75rem 0 0;
	}
	.proof span {
		display: inline-block;
		padding: 0.75rem 1.125rem;
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.35;
	}
	section,
	.prose {
		margin-top: 3rem;
	}
	h2 {
		margin-block: 0 0.875rem;
		font-size: var(--text-xl);
	}
	section p,
	.list {
		max-width: var(--measure);
		margin: 0;
	}
	.list {
		padding-left: 1.25rem;
	}
	.list li + li {
		margin-top: 0.375rem;
	}
	.related {
		padding: 0;
		list-style: none;
		font-weight: 600;
	}
	.decision {
		padding: 1.25rem 1.375rem;
		background: var(--tint);
		box-shadow: var(--shadow-sm);
	}
	.back {
		margin-top: 3.5rem;
	}
</style>
