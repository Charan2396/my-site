---
import Base from '../../layouts/Base.astro';
import { getDesigns } from '../../lib/designs';
import { stages } from '../../lib/stages';
import { url } from '../../lib/url';

const designs = await getDesigns();
const stageLabel = (key?: string) => stages.find((s) => s.key === key)?.label;
---

<Base title="Designs" description="Design docs for the systems I designed and built: problem, constraints, decision and outcome.">
	<p class="eyebrow">Designs</p>
	<h1>Selected designs</h1>
	<p class="lede">Each one is a short design doc: the problem, the constraints, the decision and what came of it.</p>
	<ol class="designs">
		{
			designs.map((d) => (
				<li class="card press">
					<p class="label">Design doc{d.data.stage && ` · ${stageLabel(d.data.stage)} stage`}</p>
					<h2>
						<a href={url(`designs/${d.id}/`)}>{d.data.title}</a>
					</h2>
					<p>{d.data.summary}</p>
					<p class="proof">{d.data.proof}</p>
				</li>
			))
		}
	</ol>
	<p class="more"><a class="btn press" href={url('decisions/')}>The decision log →</a></p>
</Base>

<style>
	h1 {
		margin-block: 0.75rem 1.25rem;
	}
	.lede {
		color: var(--muted);
	}
	.designs {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: 1rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.375rem 1.375rem;
		box-shadow: var(--shadow-sm);
	}
	.card p {
		margin: 0.5rem 0 0;
	}
	.label {
		color: var(--muted);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	h2 {
		margin: 0.375rem 0 0;
		font-size: var(--text-lg);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	/* the whole card is the link target */
	h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	.card .proof {
		margin-top: auto;
		padding-top: 1rem;
		color: var(--accent);
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.more {
		margin-top: 3rem;
	}
</style>
