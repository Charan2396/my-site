---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import { getStories } from '../lib/stories';
import { stages } from '../lib/stages';
import { url } from '../lib/url';

const stories = await getStories();
const storyByStage: Record<string, string> = {};
for (const s of stories) storyByStage[s.data.stage] ??= s.id;
const stageLabel = (key: string) => stages.find((s) => s.key === key)?.label;
---

<Base>
	<p class="eyebrow mono">Senior Data Platform Engineer</p>
	<h1>The pipeline is the portfolio.</h1>
	<p class="lede">
		I keep mainframe change data flowing through IBM MQ and Java services into Oracle and on to Google Cloud Pub/Sub, with
		a focus on reliability, data correctness and automation. Each stage below opens a story about real work I did there.
	</p>

	<Pipeline storyByStage={storyByStage} />

	{
		stories.length > 0 && (
			<section aria-labelledby="stories-heading">
				<h2 id="stories-heading">Stories</h2>
				<ul class="stories">
					{stories.map((s) => (
						<li>
							<a href={url(`stories/${s.id}/`)}>{s.data.title}</a>
							<span class="mono stage-tag">{stageLabel(s.data.stage)}</span>
							<p>{s.data.summary}</p>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	.eyebrow {
		margin: 0;
		color: var(--line);
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	h1 {
		margin-block: 0.5rem 1rem;
		font-size: clamp(2rem, 6vw, 3.25rem);
	}
	.lede {
		max-width: var(--measure);
		margin-bottom: 3rem;
		font-size: 1.1875rem;
	}
	section {
		margin-top: 4rem;
	}
	.stories {
		display: grid;
		gap: 1.5rem;
		max-width: var(--measure);
		padding: 0;
		list-style: none;
	}
	.stories a {
		font-weight: 600;
		font-size: 1.125rem;
	}
	.stage-tag {
		margin-left: 0.75rem;
		color: var(--muted);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.stories p {
		margin: 0.25rem 0 0;
	}
</style>
