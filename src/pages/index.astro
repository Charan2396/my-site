---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import ImpactStrip from '../components/ImpactStrip.astro';
import { getStories } from '../lib/stories';
import { stages } from '../lib/stages';
import { url } from '../lib/url';

const stories = await getStories();
const storyByStage: Record<string, string> = {};
for (const s of stories) storyByStage[s.data.stage] ??= s.id;
const stageLabel = (key: string) => stages.find((s) => s.key === key)?.label;
---

<Base>
	<h1>Sricharan Anand</h1>
	<p class="subtitle">Senior Data Platform Engineer · 6+ years · ex-Amazon · San Jose, CA</p>
	<ul class="contact mono" aria-label="Contact">
		<li><a href="mailto:sricharan23@gmail.com">Email</a></li>
		<li><a href="https://linkedin.com/in/charansri">LinkedIn</a></li>
		<li><a href={url('resume/')}>Resume</a></li>
	</ul>
	<p class="lede">
		I keep mainframe change data flowing through IBM MQ and Java services into Oracle and on to Google Cloud Pub/Sub, with
		a focus on reliability, data correctness and automation. Each stage below opens a story about real work I did there.
	</p>

	<ImpactStrip />

	<h2 class="tagline">The pipeline is the portfolio.</h2>
	<Pipeline storyByStage={storyByStage} />

	{
		stories.length > 0 && (
			<section aria-labelledby="stories-heading">
				<h2 id="stories-heading">Stories</h2>
				<ul class="stories">
					{stories.map((s) => (
						<li>
							<a href={url(`stories/${s.id}/`)}>{s.data.title}</a>
							<span class="mono stage-tag">{stageLabel(s.data.stage)}</span>
							<p>{s.data.summary}</p>
						</li>
					))}
				</ul>
				<p class="more mono">
					<span>More to explore</span>
					<a href={url('reconciliation/')}>Reconciliation explainer →</a>
					<a href={url('projects/simple-dynamo/')}>Simple Dynamo ring →</a>
				</p>
			</section>
		)
	}
</Base>

<style>
	h1 {
		margin-block: 0 0.25rem;
		font-size: clamp(2.25rem, 6vw, 3.25rem);
	}
	.subtitle {
		margin: 0 0 1rem;
		color: var(--line);
		font-size: clamp(1.125rem, 2.6vw, 1.5rem);
		font-weight: 600;
		line-height: 1.35;
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}
	.contact a {
		display: inline-block;
		padding: 0.375rem 0.875rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		font-size: 0.875rem;
		text-decoration: none;
	}
	.contact li:first-child a {
		background: var(--line);
		color: var(--surface);
	}
	.contact a:hover {
		text-decoration: underline;
	}
	.tagline {
		margin: 0 0 1.25rem;
		font-size: 1.375rem;
	}
	.more {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin-top: 2rem;
		font-size: 0.875rem;
	}
	.more span {
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.lede {
		max-width: var(--measure);
		margin-bottom: 2rem;
		font-size: 1.1875rem;
	}
	section {
		margin-top: 4rem;
	}
	.stories {
		display: grid;
		gap: 1.5rem;
		max-width: var(--measure);
		padding: 0;
		list-style: none;
	}
	.stories a {
		font-weight: 600;
		font-size: 1.125rem;
	}
	.stage-tag {
		margin-left: 0.75rem;
		color: var(--muted);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.stories p {
		margin: 0.25rem 0 0;
	}
</style>
