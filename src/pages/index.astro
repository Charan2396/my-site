---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import ImpactStrip from '../components/ImpactStrip.astro';
import CareerStrip from '../components/CareerStrip.astro';
import { getStories } from '../lib/stories';
import { stages } from '../lib/stages';
import { url } from '../lib/url';

const stories = await getStories();
const storyByStage: Record<string, string> = {};
for (const s of stories) storyByStage[s.data.stage] ??= s.id;
const stageLabel = (key: string) => stages.find((s) => s.key === key)?.label;
---

<Base>
	<section class="hero" aria-label="Introduction">
		<h1>Sricharan Anand</h1>
		<p class="subtitle">Senior Data Platform Engineer · 6+ years · ex-Amazon · Irvine, CA</p>
		<ul class="contact" aria-label="Contact">
			<li><a class="btn btn-primary" href="mailto:sricharan23@gmail.com">Email</a></li>
			<li><a class="btn" href="https://linkedin.com/in/charansri">LinkedIn</a></li>
			<li><a class="btn" href={url('resume/')}>Resume</a></li>
		</ul>
		<p class="lede">
			I own correctness for a real-time change-data-capture backbone: mainframe changes flow through IBM MQ and Java services
			into Oracle, and out to Google Cloud Pub/Sub for cloud consumers. I can find the one bad message among tens of thousands
			of rejects, prove which rows didn't land, and repair them by replaying from the source instead of patching the copy. Each
			stage below opens a story about real work I did there.
		</p>
	</section>
	<script is:inline>
		// Materialize the hero once per visit (opacity + scale, CSS); without JS nothing is hidden.
		(function (el) {
			try {
				if (sessionStorage.getItem('hero-seen')) return;
				sessionStorage.setItem('hero-seen', '1');
			} catch (e) {}
			el.classList.add('materialize');
		})(document.currentScript.previousElementSibling);
	</script>

	<ImpactStrip />
	<CareerStrip />

	<h2 class="tagline">The pipeline is the portfolio.</h2>
	<Pipeline storyByStage={storyByStage} />

	{
		stories.length > 0 && (
			<section class="stories-section" aria-labelledby="stories-heading">
				<h2 id="stories-heading">Stories</h2>
				<ul class="stories">
					{stories.map((s) => (
						<li>
							<a class="story card press" href={url(`stories/${s.id}/`)}>
								<span class="stage-tag">{stageLabel(s.data.stage)} stage</span>
								<span class="sr-only">: </span>
								<span class="title">{s.data.title}</span>
								<span class="go" aria-hidden="true">
									Read →
								</span>
							</a>
						</li>
					))}
				</ul>
				<div class="more">
					<span class="caption">More to explore</span>
					<a class="btn" href={url('reconciliation/')}>Reconciliation explainer →</a>
					<a class="btn" href={url('projects/simple-dynamo/')}>Simple Dynamo ring →</a>
				</div>
			</section>
		)
	}
</Base>

<style>
	.hero {
		max-width: 52rem;
		margin-bottom: 4rem;
		transform-origin: 0 0;
	}
	@media (prefers-reduced-motion: no-preference) {
		.hero.materialize {
			animation: materialize 0.7s cubic-bezier(0.25, 1, 0.5, 1) backwards;
		}
	}
	@keyframes materialize {
		from {
			opacity: 0;
			transform: scale(0.98);
		}
	}
	h1 {
		margin-block: 0 0.75rem;
		font-size: clamp(2.75rem, 8vw, 4.5rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}
	.subtitle {
		margin: 0 0 1.75rem;
		color: var(--muted);
		font-size: clamp(1.1875rem, 2.4vw, 1.625rem);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.012em;
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin: 0 0 2rem;
		padding: 0;
		list-style: none;
	}
	.lede {
		margin: 0;
	}
	.tagline {
		margin: 5rem 0 0.75rem;
		font-size: clamp(2rem, 4.5vw, 3rem);
		line-height: 1.08;
		letter-spacing: -0.025em;
	}
	.stories-section {
		margin-top: 5rem;
	}
	.stories-section h2 {
		margin: 0 0 1.25rem;
	}
	.stories {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.stories li {
		display: flex;
	}
	.story {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		width: 100%;
		padding: 1.25rem 1.375rem;
		box-shadow: var(--shadow-sm);
		color: var(--ink);
		text-decoration: none;
		transition:
			transform 100ms ease-out,
			box-shadow 0.2s ease;
	}
	.story:hover {
		text-decoration: none;
		box-shadow: var(--shadow-md);
	}
	.stage-tag {
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.title {
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
	}
	.go {
		margin-top: auto;
		padding-top: 0.5rem;
		color: var(--accent);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.more {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.625rem 0.75rem;
		margin-top: 2rem;
	}
	.more .caption {
		margin-right: 0.25rem;
	}
</style>
