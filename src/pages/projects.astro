---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
// interactive explainers, linked from the card they belong to
const explainers: Record<string, { href: string; text: string }> = {
	'simple-dynamo': { href: 'projects/simple-dynamo/', text: 'Try the interactive ring' },
	reconciliation: { href: 'reconciliation/', text: 'See how it finds drift: the interactive explainer' },
};
// A project with no Markdown body renders as a one-line entry (title, summary, repo link).
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
---

<Base title="Projects" description="A reconciliation proof of concept from my day job, graduate coursework, and this site.">
	<h1>Projects</h1>
	<p class="lede">
		A proof of concept I built on the production platform I run, then graduate coursework from the University at Buffalo, then
		this site. Each one is described only by what it does.
	</p>

	<ol class="projects">
		{
			rendered.map(({ p, Content }, i) =>
				p.body?.trim() ? (
					<li>
						<article class="card card-lg" aria-labelledby={`project-${p.id}`}>
							<p class="caption eyebrow">{p.data.label}</p>
							<h2 id={`project-${p.id}`}>{p.data.title}</h2>
							<p class="summary">{p.data.summary}</p>
							<div class="prose">
								<Content />
							</div>
							{explainers[p.id] && (
								<p class="code">
									<a href={url(explainers[p.id].href)}>{explainers[p.id].text} →</a>
								</p>
							)}
							{p.data.link && (
								<p class="code">
									<a href={p.data.link}>
										Code on GitHub<span class="sr-only">: {p.data.title}</span> →
									</a>
								</p>
							)}
						</article>
					</li>
				) : (
					<li>
						<article class="card slim" aria-labelledby={`project-${p.id}`}>
							<h2 id={`project-${p.id}`}>{p.data.title}</h2>
							<p>
								{p.data.summary}{' '}
								{p.data.link && (
									<a href={p.data.link}>
										Code on GitHub<span class="sr-only">: {p.data.title}</span> →
									</a>
								)}
							</p>
						</article>
					</li>
				),
			)
		}
	</ol>

	<p class="also">
		<span class="label">Also from grad school</span> Solr search and IR ranking evaluation (BM25, DFR, VSM)
		(<a href="https://github.com/Charan2396/Twitter-Search">code on GitHub</a>); ML coursework (CSE 674 and Pattern
		Recognition, 2019): probabilistic graphical models, explainable AI, neural networks and generative models.
	</p>
</Base>

<style>
	h1 {
		margin-block: 0 1.25rem;
	}
	.lede {
		margin-bottom: 3rem;
		color: var(--muted);
	}
	.projects {
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card {
		max-width: calc(var(--measure) + 5rem);
		padding: 2rem 2.25rem;
	}
	.caption.eyebrow {
		color: var(--accent);
		font-size: 0.875rem;
	}
	h2 {
		margin-block: 0.375rem 0.5rem;
		font-size: clamp(1.5rem, 2.6vw, 1.875rem);
	}
	.summary {
		margin-block: 0 1.25rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--rule);
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.prose :global(p) {
		margin-block: 0 1rem;
		line-height: 1.6;
	}
	/* no link after the prose: drop the trailing paragraph margin */
	.prose:last-child > :global(:last-child) {
		margin-bottom: 0;
	}
	.code {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.code + .code {
		margin-top: 0.5rem;
	}
	.also {
		max-width: calc(var(--measure) + 5rem);
		margin: 2.5rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.also .label {
		margin-right: 0.5rem;
		color: var(--ink);
		font-weight: 600;
	}
	.slim {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1rem;
		padding-block: 1.25rem;
		box-shadow: var(--shadow-md);
		border-radius: var(--radius-lg);
	}
	.slim h2 {
		margin: 0;
		font-size: 1.1875rem;
	}
	.slim p {
		margin: 0;
	}
	.slim a {
		font-weight: 600;
	}
	@media (max-width: 40rem) {
		.card {
			padding: 1.375rem 1.25rem;
		}
	}
</style>
