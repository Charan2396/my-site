---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getStories } from '../../lib/stories';
import { stages } from '../../lib/stages';
import { url } from '../../lib/url';

export async function getStaticPaths() {
	return (await getStories()).map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const stageIndex = stages.findIndex((s) => s.key === story.data.stage);
const stage = stages[stageIndex];
---

<Base title={story.data.title} description={story.data.summary}>
	<article>
		<header transition:name={`stage-${stage.key}`}>
			<p class="eyebrow">Stage {stageIndex + 1} · {stage.label} · {stage.system}</p>
			<h1>{story.data.title}</h1>
		</header>
		<p class="lede">{story.data.summary}</p>

		{
			story.data.metrics.length > 0 && (
				<ul class="metrics" aria-label="Results">
					{story.data.metrics.map((m) => (
						<li class="card">{m}</li>
					))}
				</ul>
			)
		}

		<div class="prose">
			<Content />
		</div>

		<p class="back"><a class="btn press" href={url()}>← Back to the pipeline</a></p>
	</article>
</Base>

<style>
	article {
		max-width: 48rem;
	}
	h1 {
		max-width: var(--measure);
		margin-block: 0.75rem 1.25rem;
	}
	.lede {
		margin: 0;
		color: var(--muted);
	}
	.metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2.25rem 0 2.75rem;
		padding: 0;
		list-style: none;
	}
	.metrics li {
		padding: 0.875rem 1.125rem;
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.35;
	}
	.back {
		margin-top: 3.5rem;
	}
</style>
