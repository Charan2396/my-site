---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Gloss from '../components/Gloss.astro';
import { getStories } from '../lib/stories';
import { url } from '../lib/url';

// Every claim restates a bullet in content/resume.md; `story` and `links` point to the evidence.
type Claim = { label: string; text: string; story?: string; links?: { href: string; text: string }[] };
const seen = new Set<string>(); // gloss each jargon term once on this page
const sections: { id: string; title: string; caption: string; claims: Claim[] }[] = [
	{
		id: 'design',
		title: 'How I design',
		caption: 'start from the constraints',
		claims: [
			{
				label: 'reuse before build',
				text: 'A co-designed store-and-forward IBM MQ architecture that reused infrastructure we already ran.',
				links: [{ href: 'designs/store-and-forward/', text: 'Design: store-and-forward' }],
			},
			{
				label: 'migration architecture',
				text: 'Profiled a TIBCO EMS estate first, then wrote the EMS-to-MQ migration architecture, sandbox and onboarding program.',
				links: [{ href: 'designs/ems-mq-migration/', text: 'Design: EMS to MQ migration' }],
			},
			{
				label: 'new paths',
				text: 'A co-built, real-time Java broker that takes mainframe change data to Pub/Sub as JSON for downstream teams.',
				links: [{ href: 'designs/cdc-pubsub-broker/', text: 'Design: CDC to Pub/Sub broker' }],
			},
			{
				label: 'read-only first',
				text: 'A read-only reconciliation engine across three Oracle instances, built as a proof of concept.',
				links: [
					{ href: 'designs/reconciliation-engine/', text: 'Design: reconciliation engine' },
					{ href: 'reconciliation/', text: 'Interactive explainer: how reconciliation finds drift' },
				],
			},
			{
				label: 'least privilege by design',
				text: 'Active Directory authentication for IBM MQ, with group-governed, least-privilege access.',
				links: [{ href: 'designs/ad-auth-mq/', text: 'Design: AD authentication for MQ' }],
			},
			{
				label: 'less code, faster',
				text: 'Made the message splitter faster and removed 10,000+ lines of redundant code from it.',
				story: 'splitter-30-seconds',
			},
		],
	},
	{
		id: 'change-safely',
		title: 'How I ship change safely',
		caption: 'change control',
		claims: [
			{
				label: 'upgrades',
				text: 'I led the IBM MQ upgrade lifecycle; upgrades go non-production first.',
				links: [{ href: 'decisions/#adr-04', text: 'Decision: non-production before production' }],
			},
			{
				label: 'guarded backfills',
				text: 'Backfill and purge tooling with idempotent inserts, cascade guards and zero-difference reconciliation.',
				story: 'backfill-16900',
			},
			{
				label: 'cutovers',
				text: 'I delivered production MQ queues and a remote splitter for six European countries, coordinating a weekend cutover across mainframe, Linux and consumer teams.',
			},
			{
				label: 'isolate, then fix',
				text: 'A message-ordering defect: roll back to isolate it, then redesign the queue-split logic.',
				links: [{ href: 'designs/store-and-forward/#went-wrong', text: 'What went wrong on the MQ layer' }],
			},
			{
				label: 'evidence first',
				text: 'I root-caused an Oracle trigger foreign-key race behind missing child records using systematic evidence queries, and proposed a non-invasive fix.',
			},
		],
	},
	{
		id: 'keep-up',
		title: 'How I keep it running',
		caption: 'reliability',
		claims: [
			{
				label: 'disaster recovery',
				text: "I wrote the platform's first disaster-recovery playbook (v1.0, 2023) and its recurring patching runbooks, and signed the playbook off for the 2024 and 2025 exercises.",
			},
			{
				label: 'self-healing repair',
				text: 'Failed records are regenerated from the source, by idempotent automation, not hand-patched.',
				links: [{ href: 'decisions/#adr-01', text: 'Decision: regenerate from the source' }],
			},
			{
				label: 'observability',
				text: 'Datadog observability for MQ and the Java services, including a redesigned noisy queue-depth alert.',
				story: 'log-runaway',
			},
			{
				label: 'incidents',
				text: 'Find the one message behind tens of thousands of rejects, and trace a high-CPU incident to a BigDecimal column-index error.',
				story: 'one-bad-message',
			},
		],
	},
	{
		id: 'raise-bar',
		title: 'How I raise the bar',
		caption: 'team and codebase',
		claims: [
			{
				label: 'source control',
				text: 'I introduced source control to a previously unversioned Java replication codebase, and upgraded splitter logging from Log4j 1.x to 2.x.',
			},
			{
				label: 'roadmap and standards',
				text: 'I set the 2025 platform roadmap and the pull-request standard.',
			},
			{
				label: 'people',
				text: 'I mentored engineers and sat on an Oracle DBA hiring panel.',
			},
			{
				label: 'vulnerabilities',
				text: 'I drove a middleware vulnerability backlog (Log4j, IBM MQ, IBM Java, Oracle client) toward zero.',
			},
		],
	},
];

// Concepts, not claimed experience: left = work named in content/resume.md, right = the general idea and where it shows up.
const mapping = [
	['Mainframe CDC (IMS, Db2, VSAM)', 'Change data capture from the source (the job Debezium does for Postgres or MySQL)'],
	['IBM MQ store-and-forward, message ordering', 'Durable queues and ordered delivery (queues in MQ, partitions in Kafka)'],
	['MERGE apply into Oracle, idempotent backfills', 'Idempotent upserts into a target store'],
	['Cross-instance fingerprinting and drift classification', 'Data reconciliation / data-quality checks'],
	['Self-healing key replay', 'Replay from source of truth'],
	[
		'Java broker to Pub/Sub, consumed into BigQuery',
		'Publishing a change stream to cloud consumers (I co-built the publishing side; downstream teams load AlloyDB and BigQuery)',
	],
];

// Intent, not results: each item names the habit it comes from.
const firstNinety = [
	{ text: "Map the constraints before proposing anything: what can't change, what must stay read-only, what already exists to reuse.", href: '#design', habit: 'how I design' },
	{ text: 'Learn your pipeline end to end and write down what I find, so the next person starts with a map.', href: '#keep-up', habit: 'the DR playbook and runbooks' },
	{ text: 'Pick one feed that matters and check that it reconciles, read-only first.', href: '#design', habit: 'the read-only reconciliation engine' },
	{ text: 'Find the one alert people ignore, then fix it or retire it.', href: '#keep-up', habit: 'the noisy queue-depth alert' },
	{ text: 'Write one decision record for a choice the team is about to make, so the why outlives the meeting.', href: url('decisions/'), habit: 'my decision log' },
];

const titles = new Map((await getStories()).map((s) => [s.id, s.data.title]));
// The collection exists only when content/testimonials.yaml does (see src/content.config.ts).
const testimonials = existsSync('content/testimonials.yaml') ? await getCollection('testimonials' as never) : [];
---

<Base title="How I'd work on your team" description="How I design data systems from their constraints, ship change safely, keep them running and raise the bar on a team, with links to the evidence.">
	<p class="eyebrow">Working with me</p>
	<h1>How I'd work on your team</h1>
	<p class="lede">
		I design data systems from their constraints, build them so they hold up, and write down why. Where I've written up the
		work, the line links to it.
	</p>

	{
		sections.map((s, i) => (
			<section aria-labelledby={s.id}>
				<p class="kicker">{s.caption}</p>
				<h2 id={s.id}>{s.title}</h2>
				<ul class:list={["claims", { pairs: s.claims.length === 4 }]}>
					{s.claims.map((c) => (
						<li class="card">
							<p class="label">{c.label}</p>
							<p>
								<Gloss text={c.text} seen={seen} />
							</p>
							{c.links?.map((l) => (
								<p class="story">
									<a href={url(l.href)}>{l.text} →</a>
								</p>
							))}
							{c.story && titles.has(c.story) && (
								<p class="story">
									<a href={url(`stories/${c.story}/`)}>
										<span class="sr-only">Story: </span>
										{titles.get(c.story)} →
									</a>
								</p>
							)}
						</li>
					))}
				</ul>
			</section>
		))
	}

	<section aria-labelledby="other-names">
		<p class="kicker">Concepts, not claimed experience</p>
		<h2 id="other-names">If your stack looks different</h2>
		<p class="note">The tools differ; the problems are the same. Here is how my work maps onto common concepts.</p>
		<table class="map card card-lg">
			<thead>
				<tr>
					<th scope="col">What I work with</th>
					<th scope="col">The concept, and where else it shows up</th>
				</tr>
			</thead>
			<tbody>
				{
					mapping.map(([mine, concept]) => (
						<tr>
							<th scope="row">{mine}</th>
							<td>{concept}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</section>

	<section aria-labelledby="your-problem">
		<p class="kicker">How I'd approach it</p>
		<h2 id="your-problem">Bring me your problem</h2>
		<p class="note">
			A sample problem: <strong>three databases disagree and nobody trusts the dashboard.</strong> How I'd work through it,
			and why, is in the design of the reconciliation engine I built as a proof of concept.
		</p>
		<p class="note more">
			<a href={url('designs/reconciliation-engine/')}>Read the design →</a>
			<a href={url('reconciliation/')}>See it work: the reconciliation explainer →</a>
		</p>
	</section>

	<section aria-labelledby="first-90">
		<p class="kicker">Intent, not a track record</p>
		<h2 id="first-90">What I'd do in my first 90 days on your team</h2>
		<p class="note">These are plans, built from the habits above. They aren't claims about anything I've done yet.</p>
		<ol class="plan">
			{
				firstNinety.map((p, i) => (
					<li class="card">
						<span class="step" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</span>
						<div>
							<p>{p.text}</p>
							<p class="from">
								habit: <a href={p.href}>{p.habit}</a>
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	{
		testimonials.length > 0 && (
			<section aria-labelledby="testimonials">
				<p class="kicker">In other people's words</p>
				<h2 id="testimonials">Testimonials</h2>
				<ul class="quotes">
					{testimonials.map((t: any) => (
						<li class="card">
							<blockquote>
								<p>{t.data.quote}</p>
							</blockquote>
							<p class="from">{t.data.role}</p>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="contact card card-lg" aria-labelledby="contact">
		<h2 id="contact">Let's talk</h2>
		<p>If your team needs a data system designed, built, and trusted, I'd like to hear about it.</p>
		<p class="links">
			<a class="btn btn-primary" href="mailto:sricharan23@gmail.com">Email</a>
			<a class="btn" href="https://linkedin.com/in/charansri">LinkedIn →</a>
		</p>
	</section>
</Base>

<style>
	h1 {
		max-width: 20em;
		margin-block: 0.75rem 1.25rem;
	}
	.lede {
		margin-bottom: 1rem;
		color: var(--muted);
	}
	section {
		margin-top: 5rem;
	}
	/* section kicker above each h2; sentence case from lowercase data */
	.kicker {
		margin: 0;
		color: var(--accent);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.kicker::first-letter,
	.label::first-letter {
		text-transform: uppercase;
	}
	h2 {
		margin-block: 0.375rem 1.5rem;
	}
	.claims,
	.plan,
	.quotes {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.claims {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
	}
	/* four cards read as 2 x 2 instead of 3 + an orphan */
	.claims.pairs {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
	}
	.claims .card {
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.375rem 1.375rem;
		box-shadow: var(--shadow-sm);
	}
	.label {
		margin: 0;
		color: var(--muted);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.card p {
		margin: 0.375rem 0 0;
	}
	.claims .card > p:nth-child(2) {
		line-height: 1.5;
	}
	.claims .story {
		margin-top: auto;
		padding-top: 1rem;
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.claims .story + .story {
		margin-top: 0;
		padding-top: 0.5rem;
	}
	.note {
		max-width: var(--measure);
		margin-top: 0;
		color: var(--muted);
	}
	.plan {
		max-width: calc(var(--measure) + 4rem);
	}
	.plan .card {
		display: flex;
		gap: 1.25rem;
		padding: 1.25rem 1.5rem;
		box-shadow: var(--shadow-sm);
	}
	.more {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		font-weight: 600;
	}
	.plan .card p:first-child {
		margin-top: 0;
	}
	.step {
		color: var(--accent);
		font-size: var(--text-xl);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}
	.from {
		color: var(--muted);
		font-size: var(--text-sm);
	}
	.map {
		width: 100%;
		max-width: calc(var(--measure) + 4rem);
		border-collapse: separate;
		border-spacing: 0;
		overflow: hidden;
		font-size: var(--text-sm);
	}
	.map th,
	.map td {
		padding: 0.875rem 1.25rem;
		border-bottom: 1px solid var(--rule);
		text-align: left;
		vertical-align: top;
	}
	.map tr:last-child > * {
		border-bottom: 0;
	}
	.map thead th {
		color: var(--muted);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.map tbody th {
		width: 45%;
		font-weight: 600;
	}
	blockquote {
		margin: 0;
	}
	.contact {
		max-width: calc(var(--measure) + 4rem);
		margin-top: 5rem;
		padding: 2rem;
	}
	.contact h2 {
		margin: 0 0 0.5rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin-top: 1.25rem !important;
		overflow-wrap: anywhere;
	}
	@media (max-width: 40rem) {
		.map th,
		.map td {
			padding: 0.75rem 0.875rem;
		}
		.contact {
			padding: 1.5rem 1.25rem;
		}
	}
</style>
