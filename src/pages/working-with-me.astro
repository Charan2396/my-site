---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getStories } from '../lib/stories';
import { url } from '../lib/url';

// Every claim restates a bullet in content/resume.md; `story` links the claim to its evidence.
type Claim = { label: string; text: string; story?: string; explainer?: { href: string; text: string } };
const sections: { id: string; title: string; caption: string; claims: Claim[] }[] = [
	{
		id: 'keep-up',
		title: 'How I keep systems up',
		caption: 'reliability',
		claims: [
			{
				label: 'disaster recovery',
				text: "I wrote the platform's first disaster-recovery playbook (v1.0, 2023) and its recurring patching runbooks, and signed the playbook off for the 2024 and 2025 exercises.",
			},
			{
				label: 'self-healing repair',
				text: 'I rebuilt the self-healing repair process as idempotent shell automation. It detects records that fail to land in Oracle, captures the failed keys and resends them to the mainframe, replacing a manual, Perl-based recovery.',
			},
			{
				label: 'observability',
				text: 'I set up Datadog observability for the MQ and Java replication services, with custom DogStatsD health metrics across queue managers, mainframe channels and Java processes. I redesigned a noisy queue-depth alert and shut down a log-ingestion runaway of over one billion events per day.',
				story: 'log-runaway',
			},
			{
				label: 'incidents',
				text: 'I isolated a corrupt message that made a splitter reject tens of thousands of messages, and traced a high-CPU incident to a BigDecimal column-index error.',
				story: 'one-bad-message',
			},
			{
				label: 'less downtime',
				text: 'I co-designed a store-and-forward IBM MQ architecture that cut planned-downtime exposure for a warehouse integration by over 90 percent, while reusing existing infrastructure.',
				story: 'store-and-forward',
			},
		],
	},
	{
		id: 'change-safely',
		title: 'How I change things safely',
		caption: 'change control',
		claims: [
			{
				label: 'upgrades',
				text: 'I led the IBM MQ upgrade lifecycle for a multi-environment platform and established a non-production-to-production upgrade sequence. When a client-compatibility defect appeared, I ran a controlled rollback and cold restore.',
			},
			{
				label: 'guarded backfills',
				text: 'I built backfill and purge tooling with idempotent inserts, cascade guards and zero-difference reconciliation. It recovered ~16,900 missing order-line records across 23 company codes.',
				story: 'backfill-16900',
			},
			{
				label: 'isolate, then fix',
				text: 'When the queue splitter had a message-ordering defect, I rolled back a change to isolate it, then redesigned the queue-split logic to preserve ordering.',
			},
			{
				label: 'evidence first',
				text: 'I root-caused an Oracle trigger foreign-key race behind missing child records using systematic evidence queries, and proposed a non-invasive fix.',
			},
			{
				label: 'reconciliation',
				text: 'As a proof of concept, I built a read-only engine that fingerprints each table and company code and classifies drift in both directions across three Oracle instances. It caught a flawed key heuristic before it produced false drift.',
				explainer: { href: 'reconciliation/', text: 'Interactive explainer: how reconciliation finds drift' },
			},
			{
				label: 'cutovers',
				text: 'I delivered production MQ queues and a remote splitter for six European countries, coordinating a weekend cutover across mainframe, Linux and consumer teams.',
			},
		],
	},
	{
		id: 'raise-bar',
		title: 'How I raise the bar',
		caption: 'team and codebase',
		claims: [
			{
				label: 'source control',
				text: 'I introduced source control to a previously unversioned Java replication codebase, and upgraded splitter logging from Log4j 1.x to 2.x.',
			},
			{
				label: 'less code, faster',
				text: 'I cut message-splitter processing for a 10K-message batch from roughly 3–4 minutes to about 30 seconds, and refactored the splitter layer to remove 10,000+ lines of redundant code.',
				story: 'splitter-30-seconds',
			},
			{
				label: 'new paths',
				text: 'I co-built, from scratch, a real-time Java data broker that converts raw mainframe CDC messages into JSON and publishes them to Google Cloud Pub/Sub for downstream teams.',
				story: 'pubsub-broker',
			},
			{
				label: 'sharing the plan',
				text: 'I profiled a TIBCO EMS estate of 5,000+ queues, wrote the EMS-to-MQ migration architecture, sandbox and onboarding program, and presented it to a 65-invitee audience.',
			},
			{
				label: 'also on my plate',
				text: 'I set the 2025 platform roadmap and the pull-request standard, mentored engineers and sat on an Oracle DBA hiring panel, and drove a middleware vulnerability backlog (Log4j, IBM MQ, IBM Java, Oracle client) toward zero.',
			},
		],
	},
];

// Concepts, not claimed experience: left = work named in content/resume.md, right = the general idea and where it shows up.
const mapping = [
	['Mainframe CDC (IMS, Db2, VSAM)', 'Change data capture from the source (the job Debezium does for Postgres or MySQL)'],
	['IBM MQ store-and-forward, message ordering', 'Durable queues and ordered delivery (queues in MQ, partitions in Kafka)'],
	['MERGE apply into Oracle, idempotent backfills', 'Idempotent upserts into a target store'],
	['Cross-instance fingerprinting and drift classification', 'Data reconciliation / data-quality checks'],
	['Self-healing key replay', 'Replay from source of truth'],
	[
		'Java broker to Pub/Sub, consumed into BigQuery',
		'Publishing a change stream to cloud consumers (I co-built the publishing side; downstream teams load AlloyDB and BigQuery)',
	],
];

// Intent, not results: each item names the habit above it comes from.
const firstNinety = [
	{ text: 'Learn your pipeline end to end and write down what I find, so the next person starts with a map.', from: 'keep-up', habit: 'the DR playbook and runbooks' },
	{ text: 'Find the one alert people ignore, then fix it or retire it.', from: 'keep-up', habit: 'the noisy queue-depth alert' },
	{ text: 'Walk your recovery path, a restore or a DR runbook, before anyone needs it.', from: 'keep-up', habit: 'DR exercises' },
	{ text: 'Pick one feed that matters and check that it reconciles, read-only first.', from: 'change-safely', habit: 'zero-difference reconciliation' },
	{ text: 'Ship one small change through your normal path to production, to learn how changes land.', from: 'change-safely', habit: 'the non-prod-to-prod sequence' },
];

const titles = new Map((await getStories()).map((s) => [s.id, s.data.title]));
// The collection exists only when content/testimonials.yaml does (see src/content.config.ts).
const testimonials = existsSync('content/testimonials.yaml') ? await getCollection('testimonials' as never) : [];
---

<Base title="Working with me" description="How I keep data platforms up, change them safely and raise the bar on a team, with links to the evidence.">
	<p class="eyebrow">Working with me</p>
	<h1>How I'd contribute to your team</h1>
	<p class="lede">
		Where I've written up the work as a story, the line links to it, so this page doubles as an index into the evidence.
	</p>

	{
		sections.map((s, i) => (
			<section aria-labelledby={s.id}>
				<p class="kicker">{s.caption}</p>
				<h2 id={s.id}>{s.title}</h2>
				<ul class="claims">
					{s.claims.map((c) => (
						<li class="card">
							<p class="label">{c.label}</p>
							<p>{c.text}</p>
							{c.explainer && (
								<p class="story">
									<a href={url(c.explainer.href)}>{c.explainer.text} →</a>
								</p>
							)}
							{c.story && titles.has(c.story) && (
								<p class="story">
									<a href={url(`stories/${c.story}/`)}>
										<span class="sr-only">Story: </span>
										{titles.get(c.story)} →
									</a>
								</p>
							)}
						</li>
					))}
				</ul>
			</section>
		))
	}

	<section aria-labelledby="other-names">
		<p class="kicker">Concepts, not claimed experience</p>
		<h2 id="other-names">If your stack looks different</h2>
		<p class="note">The tools differ; the problems are the same. Here is how my work maps onto common concepts.</p>
		<table class="map card card-lg">
			<thead>
				<tr>
					<th scope="col">What I work with</th>
					<th scope="col">The concept, and where else it shows up</th>
				</tr>
			</thead>
			<tbody>
				{
					mapping.map(([mine, concept]) => (
						<tr>
							<th scope="row">{mine}</th>
							<td>{concept}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</section>

	<section aria-labelledby="first-90">
		<p class="kicker">Intent, not a track record</p>
		<h2 id="first-90">What I'd do in my first 90 days on your team</h2>
		<p class="note">These are plans, built from the habits above. They aren't claims about anything I've done yet.</p>
		<ol class="plan">
			{
				firstNinety.map((p, i) => (
					<li class="card">
						<span class="step" aria-hidden="true">
							{String(i + 1).padStart(2, '0')}
						</span>
						<div>
							<p>{p.text}</p>
							<p class="from">
								habit: <a href={`#${p.from}`}>{p.habit}</a>
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	{
		testimonials.length > 0 && (
			<section aria-labelledby="testimonials">
				<p class="kicker">In other people's words</p>
				<h2 id="testimonials">Testimonials</h2>
				<ul class="quotes">
					{testimonials.map((t: any) => (
						<li class="card">
							<blockquote>
								<p>{t.data.quote}</p>
							</blockquote>
							<p class="from">{t.data.role}</p>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="contact card card-lg" aria-labelledby="contact">
		<h2 id="contact">Let's talk</h2>
		<p>If your data platform needs to be more reliable, I'd like to hear about it.</p>
		<p class="links">
			<a class="btn btn-primary" href="mailto:sricharan23@gmail.com">sricharan23@gmail.com</a>
			<a class="btn" href="https://linkedin.com/in/charansri">LinkedIn →</a>
		</p>
	</section>
</Base>

<style>
	h1 {
		max-width: 20em;
		margin-block: 0.75rem 1.25rem;
	}
	.lede {
		margin-bottom: 1rem;
		color: var(--muted);
	}
	section {
		margin-top: 5rem;
	}
	/* section kicker above each h2; sentence case from lowercase data */
	.kicker {
		margin: 0;
		color: var(--accent);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.kicker::first-letter,
	.label::first-letter {
		text-transform: uppercase;
	}
	h2 {
		margin-block: 0.375rem 1.5rem;
	}
	.claims,
	.plan,
	.quotes {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.claims {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
	}
	.claims .card {
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.375rem 1.375rem;
		box-shadow: var(--shadow-sm);
	}
	.label {
		margin: 0;
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.card p {
		margin: 0.375rem 0 0;
	}
	.claims .card > p:nth-child(2) {
		line-height: 1.5;
	}
	.claims .story {
		margin-top: auto;
		padding-top: 1rem;
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.note {
		max-width: var(--measure);
		margin-top: 0;
		color: var(--muted);
	}
	.plan {
		max-width: calc(var(--measure) + 4rem);
	}
	.plan .card {
		display: flex;
		gap: 1.25rem;
		padding: 1.25rem 1.5rem;
		box-shadow: var(--shadow-sm);
	}
	.plan .card p:first-child {
		margin-top: 0;
	}
	.step {
		color: var(--accent);
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}
	.from {
		color: var(--muted);
		font-size: 0.875rem;
	}
	.map {
		width: 100%;
		max-width: calc(var(--measure) + 4rem);
		border-collapse: separate;
		border-spacing: 0;
		overflow: hidden;
		font-size: 0.9375rem;
	}
	.map th,
	.map td {
		padding: 0.875rem 1.25rem;
		border-bottom: 1px solid var(--rule);
		text-align: left;
		vertical-align: top;
	}
	.map tr:last-child > * {
		border-bottom: 0;
	}
	.map thead th {
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.map tbody th {
		width: 45%;
		font-weight: 600;
	}
	blockquote {
		margin: 0;
	}
	.contact {
		max-width: calc(var(--measure) + 4rem);
		margin-top: 5rem;
		padding: 2rem;
	}
	.contact h2 {
		margin: 0 0 0.5rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin-top: 1.25rem !important;
		overflow-wrap: anywhere;
	}
	@media (max-width: 40rem) {
		.map th,
		.map td {
			padding: 0.75rem 0.875rem;
		}
		.contact {
			padding: 1.5rem 1.25rem;
		}
	}
</style>
